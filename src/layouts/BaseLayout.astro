---
import "../styles/global.css";
import { SITE_NAME, DISCLAIMER, SECTIONS } from "../data/site.js";
import ReportButton from "../components/ReportButton.astro";
import AuthGate from "../components/AuthGate.astro";

interface Props {
  title?: string;
  description: string;
  section?: string;
  gate?: boolean; // false = 不需要登入（只有登入頁）
}
const { title, description, section, gate = true } = Astro.props;
const fullTitle = title ? `${title}｜${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-Hant-TW" class={gate ? "gate" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="robots" content="noindex" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Chiron+Hei+HK:wght@400;500;700&display=swap" />
  </head>
  <body>
    <div class="site">
      <header class="topbar">
        <a class="logo" href="/">
          <img src="/logo.svg" alt="" width="30" height="30" />
          <b>Zhuiguang</b><span>逐光</span>
        </a>
        <nav class="nav" aria-label="主要導覽">
          {SECTIONS.map((s) => (
            <a href={s.href} aria-current={section === s.id ? "page" : undefined}>{s.zh}</a>
          ))}
        </nav>
        {gate && (
          <div class="account" id="account" hidden>
            <span></span>
            <button type="button">登出</button>
          </div>
        )}
      </header>
      <main>
        <slot />
      </main>
      <footer class="foot">
        <p>{DISCLAIMER}</p>
        <div class="links">
          <a href="/about/">關於逐光與資料來源</a>
          <a href="https://firstlight.riseatsun.com/" target="_blank" rel="noopener">First Light 初光</a>
        </div>
        <p>© {new Date().getFullYear()} 逐光｜攝影工具組・免費使用</p>
      </footer>
    </div>
    <ReportButton />
    {gate && <AuthGate />}
  </body>
</html>
