---
import "../styles/global.css";
import { SITE_NAME, DISCLAIMER, SECTIONS } from "../data/site.js";
import ReportButton from "../components/ReportButton.astro";
import AuthGate from "../components/AuthGate.astro";
import BottomNav from "../components/BottomNav.astro";
import Icon from "../components/Icon.astro";

interface Props {
  title?: string;
  description: string;
  section?: string;
  gate?: boolean; // false = 不需要登入（只有登入頁）
  bodyClass?: string;
}
const { title, description, section, gate = true, bodyClass } = Astro.props;
const fullTitle = title ? `${title}｜${SITE_NAME}` : SITE_NAME;
const isHome = Astro.url.pathname === "/";
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-Hant-TW" class={gate ? "gate" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="robots" content="noindex" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="逐光｜攝影工具組" />
    <meta property="og:locale" content="zh_TW" />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="逐光" />
    <meta name="application-name" content="逐光" />
    <meta name="theme-color" content="#1b232c" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Chiron+Hei+HK:wght@400;500;700&display=swap" />
  </head>
  <body class={bodyClass}>
    <div class="site">
      <header class="topbar">
        <a class="logo" href="/">
          <img src="/logo.svg" alt="" width="30" height="30" />
          <b>Zhuiguang</b><span>逐光</span>
        </a>
        {!isHome && gate && <nav class="nav" aria-label="主要導覽">
          {SECTIONS.map((s) => (
            <a href={s.href} aria-current={section === s.id ? "page" : undefined}>{s.zh}</a>
          ))}
        </nav>}
        {gate && (
          <div class="head-right">
            {!isHome && <a class="icon-btn" href="/?search=1" aria-label="搜尋"><Icon name="search" size={20} /></a>}
            <div class="account" id="account" hidden>
              <button type="button" class="avatar" id="avatar" aria-haspopup="true" aria-expanded="false" aria-label="帳號選單"></button>
              <div class="acct-menu" id="acct-menu" hidden>
                <span class="acct-mail"></span>
                <a class="admin-link" id="admin-link" href="/admin/" hidden>管理</a>
                <button type="button" id="signout">登出</button>
              </div>
            </div>
          </div>
        )}
      </header>
      <main>
        <slot />
      </main>
      <footer class="foot">
        <div class="donate">
          <p>覺得逐光好用？斗內支持我持續維護，完全自願，不影響任何功能。</p>
          <a class="btn" href="https://p.ecpay.com.tw/A02519C" target="_blank" rel="noopener">斗內支持</a>
          <div class="donate-note">
            <p>斗內說明：本站全部功能免費，斗內是自願支持，金額自己決定，不換取額外功能。付款透過綠界科技。斗內屬自願贈與，如果重複付款或操作錯誤，請來信說明，我會協助處理。</p>
            <p>製作者：林里歐　聯絡 Email：<a href="mailto:leo.cloudia@gmail.com">leo.cloudia@gmail.com</a></p>
          </div>
        </div>
        <p>{DISCLAIMER}</p>
        <div class="links">
          <a href="/about/">關於逐光與資料來源</a>
          <a href="/privacy/">隱私權政策</a>
          <a href="/terms/">服務條款</a>
          <a href="https://firstlight.riseatsun.com/" target="_blank" rel="noopener">First Light 初光</a>
        </div>
        <p>© {new Date().getFullYear()} 逐光｜攝影工具組・免費使用</p>
      </footer>
    </div>
    <ReportButton />
    {gate && <BottomNav current={isHome ? "home" : section} />}
    {gate && <AuthGate />}
  </body>
</html>
