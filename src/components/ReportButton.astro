---
// 回報問題：每頁右下角的按鈕。要登入才能送出（登入後送出，管理者回覆後會顯示在「我的回報」）。
// 送出時呼叫 Supabase 的 submit_issue_report() 函式，資料表本身不開放。
---
<button type="button" class="fb-btn" id="fb-open">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /><path d="M12 7v4M12 14h.01" /></svg>
  回報問題
</button>

<div class="fb-mask" id="fb-mask" hidden>
  <form class="fb-box" id="fb-form" role="dialog" aria-modal="true" aria-labelledby="fb-title" novalidate>
    <h3 id="fb-title">回報問題</h3>
    <p class="fb-meta">資料有錯、算出來怪怪的、網站壞掉，或有想要的功能，都可以告訴我們。</p>
    <label class="fb-l">問題類型
      <select id="fb-kind">
        <option>資料錯誤</option>
        <option>計算錯誤</option>
        <option>網站壞掉</option>
        <option>建議</option>
        <option>其他</option>
      </select>
    </label>
    <label class="fb-l">說明（至少 5 個字）
      <textarea id="fb-msg" maxlength="2000" rows="5" placeholder="例如：Sony FX3 的 4K 120p 位元率和原廠說明書不一樣…"></textarea>
    </label>
    <p class="fb-meta" id="fb-who"></p>
    <p class="fb-meta" id="fb-where"></p>
    <p class="fb-status" id="fb-status" role="status" aria-live="polite"></p>
    <div class="fb-row">
      <button type="button" class="btn" id="fb-mine">我的回報</button>
      <span class="fb-sp"></span>
      <button type="button" class="btn" id="fb-cancel">取消</button>
      <button type="submit" class="btn primary" id="fb-send">送出</button>
    </div>
    <div class="fb-mylist" id="fb-mylist" hidden></div>
  </form>
</div>

<script>
  import { sb, currentUser } from "../lib/auth.js";
  const $ = (id: string) => document.getElementById(id) as any;
  const openBtn = $("fb-open"), mask = $("fb-mask"), form = $("fb-form");
  const msg = $("fb-msg"), kind = $("fb-kind");
  const status = $("fb-status"), send = $("fb-send"), where = $("fb-where"), who = $("fb-who");
  const mine = $("fb-mine"), mylist = $("fb-mylist");

  const device = () => {
    const ua = navigator.userAgent;
    const os = /iPhone|iPad/.test(ua) ? "iOS" : /Android/.test(ua) ? "Android" : /Mac/.test(ua) ? "Mac" : /Windows/.test(ua) ? "Windows" : "其他";
    const br = /Edg\//.test(ua) ? "Edge" : /Chrome\//.test(ua) ? "Chrome" : /Safari\//.test(ua) ? "Safari" : /Firefox\//.test(ua) ? "Firefox" : "其他";
    return `${os}・${br}・${innerWidth}×${innerHeight}`;
  };
  const MESSAGES: Record<string, string> = {
    ok: "已收到，謝謝你！管理者回覆後，會顯示在「我的回報」。",
    login_required: "請先登入再回報問題。",
    too_short: "說明太短了，請至少寫 5 個字。",
    too_long: "內容太長了，請縮短一點（說明最多 2000 字）。",
    rate_limited: "你剛剛送出太多則了，請 10 分鐘後再試。",
    daily_limit: "今天的回報已達上限，請明天再試，謝謝。",
    closed: "回報功能暫時關閉，請稍後再試。",
  };

  const close = () => { mask.hidden = true; openBtn.focus(); };
  const open = async () => {
    status.textContent = ""; status.className = "fb-status";
    mylist.hidden = true; mylist.innerHTML = "";
    where.textContent = `回報頁面：${location.pathname}`;
    send.disabled = false; mask.hidden = false; msg.focus();
    let user = null;
    try { user = await currentUser(); } catch (e) {}
    who.textContent = user ? `以 ${user.email || "你的帳號"} 回報，管理者可以回覆你。` : "要先登入才能回報問題。";
    if (!user) {
      send.disabled = true; mine.hidden = true;
      status.className = "fb-status bad";
      status.textContent = "";
      const a = document.createElement("a");
      a.href = "/login/"; a.textContent = "前往登入";
      status.append("請先登入再回報問題。", a);
    } else mine.hidden = false;
  };
  openBtn.addEventListener("click", open);
  $("fb-cancel").addEventListener("click", close);
  mask.addEventListener("click", (e: Event) => { if (e.target === mask) close(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !mask.hidden) close(); });

  // 我的回報：狀態與管理者的回覆（一律用 textContent 顯示）
  mine.addEventListener("click", async () => {
    if (!mylist.hidden) { mylist.hidden = true; return; }
    mylist.hidden = false; mylist.textContent = "讀取中…";
    try {
      const { data, error } = await sb!.rpc("my_reports");
      if (error) throw error;
      mylist.textContent = "";
      if (!data || !data.length) { mylist.textContent = "還沒有送出過回報。"; return; }
      for (const r of data as any[]) {
        const box = document.createElement("div"); box.className = "fb-my";
        const top = document.createElement("div"); top.className = "fb-my-top";
        const d = new Date(r.created_at);
        top.textContent = `${r.kind}・${d.getMonth() + 1}/${d.getDate()}・${r.status}`;
        const body = document.createElement("div"); body.className = "fb-my-msg"; body.textContent = r.message;
        box.append(top, body);
        if (r.reply) { const rp = document.createElement("div"); rp.className = "fb-my-reply"; rp.textContent = "管理者回覆：" + r.reply; box.append(rp); }
        mylist.append(box);
      }
    } catch (e) {
      mylist.textContent = "讀取失敗，請稍後再試。";
    }
  });

  form.addEventListener("submit", async (e: Event) => {
    e.preventDefault();
    const text = msg.value.trim();
    const fail = (t: string) => { status.textContent = t; status.className = "fb-status bad"; send.disabled = false; };
    if (text.length < 5) return fail(MESSAGES.too_short);
    if (!sb) return fail("回報功能還在設定中，暫時無法送出，抱歉。");
    send.disabled = true; status.className = "fb-status"; status.textContent = "送出中…";
    try {
      const { data, error } = await sb.rpc("submit_issue_report", {
        p_kind: kind.value, p_page: location.pathname + location.search, p_message: text, p_contact: "", p_device: device(),
      });
      if (error) throw error;
      if (data === "ok") {
        status.textContent = MESSAGES.ok; status.className = "fb-status good";
        msg.value = "";
        setTimeout(() => { if (!mask.hidden) close(); }, 2200);
      } else fail(MESSAGES[data as string] || "送出失敗，請稍後再試。");
    } catch {
      fail("送出失敗，請檢查網路後再試一次。");
    }
  });
</script>
