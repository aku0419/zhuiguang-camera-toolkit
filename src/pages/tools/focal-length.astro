---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolHead from "../../components/ToolHead.astro";
import Chips from "../../components/Chips.astro";
import CameraPicker from "../../components/CameraPicker.astro";
import { FORMATS } from "../../lib/calc.js";
---
<BaseLayout title="等效焦段計算器" description="把 APS-C、Super35、M43、1 吋相機的焦段換算成全片幅等效焦段。例如 Sony APS-C 35mm ≈ 全片幅 52.5mm。" section="tools">
  <ToolHead title="等效焦段計算器" question="這顆鏡頭裝在我的相機上，等於全片幅的幾 mm？" />
  <div class="tool">
    <CameraPicker />
    <div class="field" id="fmt-field">
      <label for="fmt">相機片幅</label>
      <select id="fmt">
        {FORMATS.map((f) => <option value={f.id} data-factor={f.factor}>{f.label}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="focal">鏡頭焦段</label>
      <div class="inrow"><input id="focal" type="number" inputmode="decimal" min="1" step="any" value="35" /><span class="unit">mm</span></div>
      <Chips label="常用焦段" values={[14, 24, 35, 50, 85, 135]} />
    </div>
    <div class="result" aria-live="polite">
      <p class="lbl">全片幅等效焦段</p>
      <p class="big" id="out">—</p>
      <p class="sub" id="factor"></p>
    </div>
    <p class="formula">算法：等效焦段 ＝ 鏡頭焦段 × 換算倍率（以全片幅 36 × 24 mm 為準）</p>
    <ul class="notes">
      <li>等效焦段只代表「視角」，鏡頭本身的焦段不會改變。</li>
      <li>Super35 沒有統一尺寸，每台攝影機略有不同（約 1.4～1.6 倍）。這裡的 1.5 倍是約略值；從攝影機頁面進來時，會用那台的實際感光元件尺寸計算。</li>
      <li>相機開啟裁切模式（例如 4K 120p 裁切）時，視角會再變窄。</li>
    </ul>
  </div>
</BaseLayout>

<script>
  import { equivalentFocal, FORMATS, fmt } from "../../lib/calc.js";
  import { bindChips, num, fromQuery, cameraPicker } from "../../lib/ui.js";
  const sel = document.getElementById("fmt") as HTMLSelectElement;
  const focal = document.getElementById("focal") as HTMLInputElement;
  const out = document.getElementById("out")!;
  const factorEl = document.getElementById("factor")!;
  const q = new URLSearchParams(location.search);
  if (FORMATS.some((f) => f.id === q.get("format"))) sel.value = q.get("format")!;
  let getCam: () => any = () => null;
  const fmtField = document.getElementById("fmt-field")!;
  const update = () => {
    const cam = getCam();
    const useCam = cam && cam.crop_factor;
    // 相機沒有公布尺寸時，改用片幅的通用倍率
    if (cam && !useCam && cam.format_id && sel.value !== cam.format_id && !sel.dataset.touched) sel.value = cam.format_id;
    fmtField.hidden = !!useCam;
    const f = useCam ? { factor: cam.crop_factor, approx: false } : FORMATS.find((x) => x.id === sel.value)!;
    const r = equivalentFocal(num(focal), f.factor);
    if (r == null) { out.textContent = "—"; factorEl.textContent = "請輸入焦段"; return; }
    out.textContent = `${f.approx ? "約 " : ""}${fmt(r, 1)} mm`;
    factorEl.innerHTML = useCam
      ? `依 ${cam.name} 實際感光元件尺寸，換算倍率 <b>${fmt(f.factor, 2)}×</b>（未開裁切模式時）`
      : `換算倍率 <b>${f.factor}×</b>${f.approx ? "（約略值）" : ""}${cam ? `（${cam.name} 原廠未公布感光元件尺寸，使用通用倍率）` : ""}`;
  };
  getCam = cameraPicker(update);
  fromQuery({ focal });
  bindChips(document.querySelector<HTMLElement>(".chips")!, focal, update);
  sel.addEventListener("change", () => { sel.dataset.touched = "1"; update(); });
  update();
</script>
