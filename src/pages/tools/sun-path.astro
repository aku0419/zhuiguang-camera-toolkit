    ctx.font = "bold 13px sans-serif"; ctx.textAlign = "left"; ctx.textBaseline = "middle";
    for (let h = 0; h < 24; h++) {
      const pt = P[h * 12];
      if (!pt || pt.alt < -6) continue;
      const q = project(pt.az, pt.alt);
