  });

  // ---- 指南針與傾斜 ----
  let listening = false;
  let oriAlpha: number | null = null, oriBeta: number | null = null, oriGamma: number | null = null;
  const angDiff = (a: number, b: number) => ((a - b + 540) % 360) - 180;
  function onOrientation(ev: any) {
    let h: number | null = null;
    if (typeof ev.webkitCompassHeading === "number") h = ev.webkitCompassHeading;       // iPhone
    else if (ev.absolute && typeof ev.alpha === "number") h = (360 - ev.alpha) % 360;    // Android
    if (typeof ev.beta === "number") tiltBeta = ev.beta;
    if (typeof ev.beta === "number") oriBeta = oriBeta == null ? ev.beta : oriBeta + (ev.beta - oriBeta) * 0.35;
    if (typeof ev.gamma === "number") oriGamma = oriGamma == null ? ev.gamma : oriGamma + (ev.gamma - oriGamma) * 0.35;
    if (h == null || !isFinite(h)) return;
    rawHeading = h;
    const aAbs = (360 - h + 360) % 360;       // 換成「W3C 定義的 alpha」（逆時針、從北算）
    oriAlpha = oriAlpha == null ? aAbs : (oriAlpha + angDiff(aAbs, oriAlpha) * 0.35 + 360) % 360;
    const target = (h + offset + 360) % 360;
    heading = heading == null ? target : (heading + angDiff(target, heading) * 0.3 + 360) % 360;   // 平滑一點，畫面比較不會抖
    yaw = heading;
    if (tiltBeta != null) {
      const targetPitch = Math.min(86, Math.max(12, 90 - tiltBeta));
