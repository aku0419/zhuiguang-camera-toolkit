---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolHead from "../../components/ToolHead.astro";

// 常用拍攝地點（經緯度是公開的地理座標，時差 8 或 9）
const PLACES = [
  { id: "taipei", name: "台北", lat: 25.033, lon: 121.565, tz: 8 },
  { id: "taichung", name: "台中", lat: 24.147, lon: 120.674, tz: 8 },
  { id: "kaohsiung", name: "高雄", lat: 22.627, lon: 120.301, tz: 8 },
  { id: "hualien", name: "花蓮", lat: 23.977, lon: 121.604, tz: 8 },
  { id: "taitung", name: "台東", lat: 22.756, lon: 121.145, tz: 8 },
  { id: "penghu", name: "澎湖", lat: 23.571, lon: 119.579, tz: 8 },
  { id: "tokyo", name: "東京", lat: 35.676, lon: 139.65, tz: 9 },
];
---
<BaseLayout title="太陽軌跡・日出日落・黃金時刻" description="算出拍攝地點與日期的日出、日落、黃金時刻、藍調時刻，並畫出太陽一整天的軌跡與方位。可用手機定位與指南針，不用網路也能算。" section="tools">
  <ToolHead title="太陽軌跡" question="那天幾點日出日落？黃金時刻、藍調時刻是什麼時候？太陽會從哪個方向來？" />
  <div class="tool sun">
    <div class="field">
      <label for="place">拍攝地點</label>
      <div class="inrow">
        <select id="place">
          {PLACES.map((p) => <option value={p.id}>{p.name}</option>)}
          <option value="custom">自己輸入經緯度</option>
        </select>
        <button type="button" class="btn" id="gps">使用目前位置</button>
      </div>
      <span class="hint" id="gps-msg">位置只在你的手機瀏覽器裡計算，不會傳送到任何地方。</span>
    </div>
    <div class="field two">
      <div>
        <label for="lat">緯度（北為正）</label>
        <input id="lat" type="number" inputmode="decimal" step="any" min="-90" max="90" value="25.033" />
      </div>
      <div>
        <label for="lon">經度（東為正）</label>
        <input id="lon" type="number" inputmode="decimal" step="any" min="-180" max="180" value="121.565" />
      </div>
    </div>
    <div class="field two">
      <div>
        <label for="date">日期</label>
        <input id="date" type="date" />
      </div>
      <div>
        <label for="tz">時差（UTC＋幾小時）</label>
        <input id="tz" type="number" inputmode="decimal" step="0.5" min="-12" max="14" value="8" />
      </div>
    </div>

    <div class="sun-times" id="times" aria-live="polite"></div>

    <div class="field">
      <label for="slider">時間：<b class="num" id="clock">12:00</b>　<button type="button" class="chip" id="now">回到現在</button></label>
      <input id="slider" type="range" min="0" max="1439" step="1" value="720" />
      <p class="sun-now" id="nowinfo"></p>
    </div>

    <figure class="sun-fig">
      <svg id="alt-chart" viewBox="0 0 360 170" role="img" aria-label="一天中太陽高度的變化"></svg>
      <figcaption>太陽高度（一整天）。深色是夜晚、藍色是藍調時刻、黃色是黃金時刻。</figcaption>
    </figure>
    <figure class="sun-fig">
      <canvas id="sky" aria-label="太陽軌跡立體圖"></canvas>
      <div class="inrow sun-views">
        <button type="button" class="chip" data-pitch="86">俯視</button>
        <button type="button" class="chip" data-pitch="40">斜視</button>
        <button type="button" class="chip" data-pitch="14">正面</button>
        <button type="button" class="chip" id="play">播放一天</button>
        <button type="button" class="chip" id="ar-open">AR 模式（開相機）</button>
      </div>
      <figcaption>立體圖：圓盤是地面（四周是方位），弧線是太陽這一天的路徑，點是每小時的位置。<b>左右拖曳</b>可以轉動方向；開啟指南針後，畫面會跟著手機轉，手機立起來就變成正面看、放平就變成俯視。</figcaption>
    </figure>

    <div class="field">
      <span class="label">指南針（用手機的方向感測器）</span>
      <div class="inrow">
        <button type="button" class="btn" id="compass-btn">開啟指南針</button>
        <button type="button" class="btn" id="calib" hidden>對著太陽校正</button>
      </div>
      <p class="sun-now" id="compass-info"></p>
      <span class="hint">開啟後，立體圖會跟著手機的方向與傾斜轉動，並告訴你太陽在你的哪一側。指南針附近有金屬或磁鐵會偏，可以在看得到太陽時，把手機上方對準太陽，按「對著太陽校正」。</span>
    </div>

    <ul class="notes">
      <li><b>黃金時刻</b>這裡定義為太陽高度 −4° 到 +6°，<b>藍調時刻</b>為 −6° 到 −4°。各軟體的定義不同，所以是<b>估算</b>，請當作到場規劃的參考。</li>
      <li>日出、日落是太陽上緣碰到地平線的時間（含大氣折射），沒考慮山、建築物的遮擋。實際看到太陽的時間，山區或高樓旁會晚（日出）或早（日落）。</li>
      <li>算法是常見的天文公式，日出日落通常誤差 1～2 分鐘。需要精準時間（例如拍攝關鍵鏡頭）請以現場為準。</li>
      <li>時差預設是你手機的時區。到國外拍攝時，請把時差改成當地的。</li>
    </ul>
  </div>

  <div class="ar" id="ar" hidden>
    <video id="ar-video" playsinline muted autoplay></video>
    <canvas id="ar-canvas"></canvas>
    <div class="ar-top">
      <p id="ar-info">相機啟動中……</p>
      <button type="button" id="ar-close" aria-label="關閉 AR 模式">關閉</button>
    </div>
    <div class="ar-bottom">
      <p class="ar-warn">請不要用相機或眼睛長時間直視太陽。</p>
      <div class="ar-row">
        <label>時間 <b id="ar-clock">--:--</b></label>
        <input id="ar-slider" type="range" min="0" max="1439" step="1" value="720" />
        <button type="button" id="ar-now">現在</button>
      </div>
      <div class="ar-row">
        <select id="ar-lens" aria-label="手機鏡頭">
          <option value="13">超廣角（約 13mm）</option>
          <option value="24" selected>主鏡頭（約 24mm）</option>
          <option value="48">2 倍（約 48mm）</option>
          <option value="77">3 倍（約 77mm）</option>
          <option value="120">5 倍（約 120mm）</option>
        </select>
        <button type="button" id="ar-calib">太陽在畫面中央，按此校正</button>
      </div>
      <p class="ar-hint" id="ar-hint"></p>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .sun .two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .sun .two > div{display:flex;flex-direction:column;gap:6px}
  .sun .two label,.sun .field > label{font-size:14px;font-weight:700}
  .sun input[type=date]{font-size:17px;padding:10px 12px;border:1px solid var(--line);border-radius:8px;background:var(--soft);width:100%}
  .sun input[type=range]{width:100%;accent-color:var(--accent)}
  .sun .btn{flex:none;border:1px solid var(--line);background:var(--paper);border-radius:8px;padding:9px 14px;font-weight:700;cursor:pointer;font-size:14px;white-space:nowrap}
  .sun .btn:hover{border-color:var(--muted)}
  .sun-times{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin:4px 0 18px}
  .sun-times > div{background:var(--soft);border:1px solid var(--line);border-radius:8px;padding:8px 10px}
  .sun-times .k{font-size:12px;color:var(--muted);margin:0}
  .sun-times .v{font-family:var(--mono);font-size:17px;margin:2px 0 0}
  .sun-times .s{font-size:12px;color:var(--muted);margin:0}
  .sun-times .gold{border-color:#e0a93b;background:rgba(245,176,40,.16)}
  .sun-times .blue{border-color:#5b8fd6;background:rgba(80,130,210,.14)}
  .sun-times .wide{grid-column:1 / -1}
  .sun-now{font-size:15px;margin:6px 0 0}
  .sun-now b{font-family:var(--mono);font-weight:500}
  .sun-fig{margin:0 0 16px}
  .sun-fig svg,.sun-fig canvas{width:100%;height:auto;display:block;background:var(--soft);border:1px solid var(--line);border-radius:8px}
  .sun-fig canvas{aspect-ratio:1 / 1;touch-action:pan-y;cursor:grab;background:#0b0d12;border-color:#222}
  .sun-views{margin-top:8px;flex-wrap:wrap}
  .sun-fig figcaption{font-size:13px;color:var(--muted);margin-top:4px}
  .sun-fig text{font-family:var(--mono);fill:var(--muted);font-size:9px}

  .ar{position:fixed;inset:0;z-index:100;background:#000;color:#fff;overflow:hidden}
  .ar video,.ar canvas{position:absolute;inset:0;width:100%;height:100%}
  .ar video{object-fit:cover}
  .ar canvas{touch-action:none}
  .ar-top{position:absolute;top:0;left:0;right:0;display:flex;justify-content:space-between;align-items:flex-start;gap:8px;padding:calc(env(safe-area-inset-top) + 10px) 12px 8px;background:linear-gradient(rgba(0,0,0,.55),rgba(0,0,0,0))}
  .ar-top p{margin:0;font-size:14px;min-width:0;text-shadow:0 1px 3px #000}
  .ar-top button,.ar-bottom button{white-space:nowrap;flex:none;background:rgba(0,0,0,.55);color:#fff;border:1px solid rgba(255,255,255,.5);border-radius:8px;padding:8px 12px;font-size:14px;font-weight:700;cursor:pointer}
  .ar-bottom{position:absolute;bottom:0;left:0;right:0;padding:24px 12px calc(env(safe-area-inset-bottom) + 12px);background:linear-gradient(rgba(0,0,0,0),rgba(0,0,0,.65));display:flex;flex-direction:column;gap:8px}
  .ar-row{display:flex;align-items:center;gap:8px}
  .ar-row label{font-size:14px;white-space:nowrap}
  .ar-row input[type=range]{flex:1;min-width:0}
  .ar-row select{flex:1;min-width:0;background:rgba(0,0,0,.55);color:#fff;border:1px solid rgba(255,255,255,.5);border-radius:8px;padding:8px;font-size:14px;width:auto}
  .ar-warn,.ar-hint{margin:0;font-size:12px;opacity:.85;text-shadow:0 1px 3px #000}
  @media (min-width:560px){.sun-times{grid-template-columns:repeat(4,1fr)}}
</style>

<script>
  import { sunPosition, sunTimes, fmtClock, compassName, fmt } from "../../lib/calc.js";
  import { num } from "../../lib/ui.js";

  const PLACES: Record<string, { lat: number; lon: number; tz: number }> = {
    taipei: { lat: 25.033, lon: 121.565, tz: 8 }, taichung: { lat: 24.147, lon: 120.674, tz: 8 },
    kaohsiung: { lat: 22.627, lon: 120.301, tz: 8 }, hualien: { lat: 23.977, lon: 121.604, tz: 8 },
    taitung: { lat: 22.756, lon: 121.145, tz: 8 }, penghu: { lat: 23.571, lon: 119.579, tz: 8 },
    tokyo: { lat: 35.676, lon: 139.65, tz: 9 },
  };
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const place = $("place"), lat = $("lat"), lon = $("lon"), date = $("date"), tz = $("tz"), slider = $("slider");
  const timesEl = document.getElementById("times")!, clockEl = document.getElementById("clock")!, nowInfo = document.getElementById("nowinfo")!;
  const altChart = document.getElementById("alt-chart")!;
  const sky = document.getElementById("sky") as HTMLCanvasElement;
  const gpsBtn = $("gps"), gpsMsg = document.getElementById("gps-msg")!;
  const compassBtn = $("compass-btn"), calibBtn = $("calib"), compassInfo = document.getElementById("compass-info")!;
  const playBtn = $("play");

  // 手機方向：raw 是感測器讀到的；heading 是校正後的
  let rawHeading: number | null = null;
  let heading: number | null = null;
  let tiltBeta: number | null = null;
  let offset = 0;
  try { offset = Number(localStorage.getItem("zg-compass-offset")) || 0; } catch { /* 不能存也沒關係 */ }
  // 立體圖視角：yaw ＝畫面「前方」是哪個方位；pitch ＝從幾度往下看（90 俯視、0 正面）
  let yaw = 180, pitch = 36;
  let drawnYaw = yaw, drawnPitch = pitch;

  const pad = (n: number) => String(n).padStart(2, "0");
  const todayStr = () => { const d = new Date(Date.now() + num(tz) * 3600000); return `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}`; };
  const nowMinute = () => { const d = new Date(Date.now() + num(tz) * 3600000); return d.getUTCHours() * 60 + d.getUTCMinutes(); };
  tz.value = String(-new Date().getTimezoneOffset() / 60);
  date.value = todayStr();
  slider.value = String(nowMinute());

  function valid() { return isFinite(num(lat)) && isFinite(num(lon)) && isFinite(num(tz)) && !!date.value; }

  // ---- 計算結果（地點、日期改了才重算）----
  type Scene = { t: ReturnType<typeof sunTimes>; la: number; lo: number; z: number; path: { min: number; az: number; alt: number }[]; chartBase: string };
  let scene: Scene | null = null;

  function recompute() {
    if (!valid()) { scene = null; timesEl.innerHTML = "<p>請輸入緯度、經度、日期與時差。</p>"; return; }
    const [y, m, d] = date.value.split("-").map(Number);
    const la = num(lat), lo = num(lon), z = num(tz);
    const t = sunTimes(y, m, d, la, lo, z);
    const path: Scene["path"] = [];
    for (let min = 0; min <= 1440; min += 5) {
      const p = sunPosition(t.start + min * 60000, la, lo);
      path.push({ min, az: p.azimuth, alt: p.altitude });
    }

    const at = (ms: number | null) => (ms == null ? "" : `方位 ${fmt(sunPosition(ms, la, lo).azimuth, 0)}°（${compassName(sunPosition(ms, la, lo).azimuth)}）`);
    const c = (cls: string, k: string, a: number | null, b: number | null, sub = "") =>
      `<div class="${cls}"><p class="k">${k}</p><p class="v">${a == null ? "—" : fmtClock(a, z)}${b != null ? "～" + fmtClock(b, z) : ""}</p>${sub ? `<p class="s">${sub}</p>` : ""}</div>`;
    if (t.alwaysUp || t.alwaysDown) {
      timesEl.innerHTML = `<div class="wide"><p class="k">這天這個地點</p><p class="v">${t.alwaysUp ? "太陽整天不下山（永晝）" : "太陽整天不出來（永夜）"}</p></div>`;
    } else {
      timesEl.innerHTML =
        c("blue", "早上藍調（估算）", t.blueMorningStart, t.blueMorningEnd) +
        c("gold", "早上黃金（估算）", t.goldenMorningStart, t.goldenMorningEnd) +
        c("", "日出", t.sunrise, null, at(t.sunrise)) +
        c("", "正午（最高）", t.noon, null, `高度 ${fmt(t.noonAltitude, 0)}°`) +
        c("", "日落", t.sunset, null, at(t.sunset)) +
        c("gold", "傍晚黃金（估算）", t.goldenEveningStart, t.goldenEveningEnd) +
        c("blue", "傍晚藍調（估算）", t.blueEveningStart, t.blueEveningEnd) +
        `<div><p class="k">白天長度</p><p class="v">${t.dayMinutes == null ? "—" : `${Math.floor(t.dayMinutes / 60)}時${pad(Math.round(t.dayMinutes % 60))}分`}</p></div>`;
    }

    // 高度曲線的底圖（不含目前時間的標記）
    const W = 360, H = 170, L = 26, R = 8, T = 8, B = 20, aMin = -30, aMax = 90;
    const px = (min: number) => L + ((W - L - R) * min) / 1440;
    const py = (a: number) => T + ((H - T - B) * (aMax - Math.min(aMax, Math.max(aMin, a)))) / (aMax - aMin);
    const cols: string[] = [];
    for (let i = 0; i < 144; i++) {
      const a = path[i * 2 + 1].alt;
      cols.push(a > 6 ? "" : a > -4 ? "rgba(245,176,40,.38)" : a > -6 ? "rgba(80,130,210,.35)" : "rgba(20,28,60,.28)");
    }
    let bands = "";
    for (let i = 0; i < 144;) {   // 相鄰同色的時段合併成一條，避免接縫
      let j = i;
      while (j < 144 && cols[j] === cols[i]) j++;
      if (cols[i]) bands += `<rect x="${px(i * 10)}" y="${T}" width="${px(j * 10) - px(i * 10)}" height="${H - T - B}" fill="${cols[i]}"/>`;
      i = j;
    }
    let line = "";
    path.forEach((p, i) => { line += `${i === 0 ? "M" : "L"}${px(p.min).toFixed(1)},${py(p.alt).toFixed(1)}`; });
    const ticks = [0, 3, 6, 9, 12, 15, 18, 21, 24].map((h) => `<text x="${px(h * 60)}" y="${H - 6}" text-anchor="middle">${h}</text>`).join("");
    const yt = [0, 30, 60, 90].map((a) => `<line x1="${L}" x2="${W - R}" y1="${py(a)}" y2="${py(a)}" stroke="currentColor" opacity="${a === 0 ? 0.55 : 0.15}"/><text x="${L - 3}" y="${py(a) + 3}" text-anchor="end">${a}°</text>`).join("");
    scene = { t, la, lo, z, path, chartBase: `${bands}${yt}${ticks}<path d="${line}" fill="none" stroke="#e8890c" stroke-width="2"/>` };
    (scene as any).px = px; (scene as any).py = py; (scene as any).H = H; (scene as any).T = T; (scene as any).B = B;
    refresh();
  }

  // ---- 目前選的時間（滑桿動就更新）----
  function refresh() {
    if (!scene) return;
    const { t, la, lo } = scene;
    const minute = Number(slider.value);
    const pos = sunPosition(t.start + minute * 60000, la, lo);
    clockEl.textContent = `${pad(Math.floor(minute / 60))}:${pad(minute % 60)}`;
    const shadow = pos.altitude > 0.5 ? `，物體影子長度約是高度的 ${fmt(1 / Math.tan((pos.altitude * Math.PI) / 180), 1)} 倍` : "";
    nowInfo.innerHTML = pos.altitude > -0.833
      ? `太陽在<b>${compassName(pos.azimuth)}</b>（方位 ${fmt(pos.azimuth, 0)}°），高度 <b>${fmt(pos.altitude, 0)}°</b>${shadow}。`
      : `太陽在地平線下（高度 ${fmt(pos.altitude, 0)}°）。`;
    const { px, py, H, T, B } = scene as any;
    const mx = px(minute), my = py(pos.altitude);
    altChart.innerHTML = `${scene.chartBase}<line x1="${mx}" x2="${mx}" y1="${T}" y2="${H - B}" stroke="currentColor" opacity=".45" stroke-dasharray="3 3"/><circle cx="${mx}" cy="${my}" r="5" fill="#ffc83d" stroke="#b86c00" stroke-width="1.5"/>`;
    if (heading != null) {
      const diff = ((pos.azimuth - heading + 540) % 360) - 180;
      const side = pos.altitude < -0.833 ? "（太陽在地平線下）" : Math.abs(diff) < 8 ? "，在你的<b>正前方</b>" : Math.abs(diff) > 172 ? "，在你的<b>正後方</b>" : `，在你的<b>${diff > 0 ? "右" : "左"}邊 ${fmt(Math.abs(diff), 0)}°</b>`;
      compassInfo.innerHTML = `你面對 <b>${compassName(heading)}</b>（${fmt(heading, 0)}°）；圖上選的時間${side}。`;
    }
    render3D();
  }

  // ---- 立體圖（自己用畫布畫，不需要外部程式庫）----
  const DEG = Math.PI / 180;
  function render3D() {
    if (!scene) return;
    const cssW = sky.clientWidth || 320;
    const dpr = window.devicePixelRatio || 1;
    if (sky.width !== Math.round(cssW * dpr)) { sky.width = Math.round(cssW * dpr); sky.height = sky.width; }
    const ctx = sky.getContext("2d")!;
    const S = sky.width;
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, S, S);
    ctx.scale(S / 320, S / 320);        // 之後都用 320×320 的座標

    const cy_ = Math.cos(yaw * DEG), sy_ = Math.sin(yaw * DEG);
    const cp = Math.cos(pitch * DEG), sp = Math.sin(pitch * DEG);
    const D = 3.4, F = 2.6;
    // 世界座標（x 東、y 北、z 上）→ 畫面
    const project = (x: number, y: number, z: number) => {
      const xr = x * cy_ - y * sy_;                 // 向右
      const yf = x * sy_ + y * cy_;                 // 向前（畫面往遠處）
      const u = z * cp + yf * sp;                   // 向上
      const dz = yf * cp - z * sp;                  // 深度
      const k = (F / (D + dz)) * 118;
      return { x: 160 + xr * k, y: 175 - u * k, k };
    };
    const dir = (az: number, alt: number, r = 1) => {
      const a = az * DEG, h = alt * DEG;
      return [Math.sin(a) * Math.cos(h) * r, Math.cos(a) * Math.cos(h) * r, Math.sin(h) * r] as const;
    };

    // 地面圓盤
    ctx.beginPath();
    for (let a = 0; a <= 360; a += 5) { const q = project(...dir(a, 0)); a === 0 ? ctx.moveTo(q.x, q.y) : ctx.lineTo(q.x, q.y); }
    ctx.fillStyle = "rgba(255,255,255,.05)"; ctx.fill();
    ctx.strokeStyle = "rgba(255,255,255,.55)"; ctx.lineWidth = 1.2; ctx.stroke();
    // 高度環（30°、60°）
    for (const alt of [30, 60]) {
      ctx.beginPath();
      for (let a = 0; a <= 360; a += 6) { const q = project(...dir(a, alt)); a === 0 ? ctx.moveTo(q.x, q.y) : ctx.lineTo(q.x, q.y); }
      ctx.strokeStyle = "rgba(255,255,255,.13)"; ctx.lineWidth = 1; ctx.stroke();
    }
    // 方位刻度與文字
    ctx.font = "bold 12px sans-serif"; ctx.textAlign = "center"; ctx.textBaseline = "middle";
    for (let a = 0; a < 360; a += 15) {
      const q1 = project(...dir(a, 0, 1)), q2 = project(...dir(a, 0, a % 90 === 0 ? 0.93 : 0.96));
      ctx.beginPath(); ctx.moveTo(q1.x, q1.y); ctx.lineTo(q2.x, q2.y);
      ctx.strokeStyle = "rgba(255,255,255,.4)"; ctx.lineWidth = 1; ctx.stroke();
    }
    for (const [n, a] of [["北", 0], ["東", 90], ["南", 180], ["西", 270]] as const) {
      const q = project(...dir(a, 0, 1.12));
      ctx.fillStyle = a === 0 ? "#ff6b5b" : "#e6e6e6"; ctx.fillText(n, q.x, q.y);
    }
    ctx.font = "9px sans-serif";
    for (const [n, a] of [["東北", 45], ["東南", 135], ["西南", 225], ["西北", 315]] as const) {
      const q = project(...dir(a, 0, 1.1)); ctx.fillStyle = "rgba(255,255,255,.55)"; ctx.fillText(n, q.x, q.y);
    }

    // 日出、日落方向
    const { t, la, lo, path } = scene;
    for (const [ms, col] of [[t.sunrise, "#ffa24d"], [t.sunset, "#ff5a4d"]] as const) {
      if (ms == null) continue;
      const az = sunPosition(ms, la, lo).azimuth;
      const o = project(0, 0, 0), q = project(...dir(az, 0));
      ctx.beginPath(); ctx.moveTo(o.x, o.y); ctx.lineTo(q.x, q.y);
