  window.addEventListener("resize", scheduleRender);

  // 左右拖曳轉方向（沒開指南針時）
  let dragX: number | null = null;
  sky.addEventListener("pointerdown", (e) => { if (heading == null) { dragX = e.clientX; sky.setPointerCapture(e.pointerId); sky.style.cursor = "grabbing"; } });
  sky.addEventListener("pointermove", (e) => {
    if (dragX == null) return;
    yaw = (yaw - (e.clientX - dragX) * 0.6 + 360) % 360; dragX = e.clientX; scheduleRender();
  });
  const endDrag = () => { dragX = null; sky.style.cursor = "grab"; };
  sky.addEventListener("pointerup", endDrag); sky.addEventListener("pointercancel", endDrag);
  document.querySelectorAll<HTMLElement>("[data-pitch]").forEach((b) => b.addEventListener("click", () => { pitch = Number(b.dataset.pitch); scheduleRender(); }));

  // 播放一天
  let timer: number | null = null;
  playBtn.addEventListener("click", () => {
    if (timer != null) { clearInterval(timer); timer = null; playBtn.textContent = "播放一天"; return; }
    playBtn.textContent = "暫停";
    timer = window.setInterval(() => {
      slider.value = String((Number(slider.value) + 6) % 1440);
      refresh();
    }, 50);
  });

  // ---- 地點 ----
  place.addEventListener("change", () => {
    const p = PLACES[place.value];
    if (p) { lat.value = String(p.lat); lon.value = String(p.lon); tz.value = String(p.tz); }
    recompute();
  });
  for (const el of [lat, lon, tz]) el.addEventListener("input", () => { if (el !== tz) place.value = "custom"; recompute(); });
  date.addEventListener("input", recompute);
  slider.addEventListener("input", refresh);
  document.getElementById("now")!.addEventListener("click", () => { date.value = todayStr(); slider.value = String(nowMinute()); recompute(); });

  gpsBtn.addEventListener("click", () => {
    if (!("geolocation" in navigator)) { gpsMsg.textContent = "這個瀏覽器不支援定位，請從清單選地點或自己輸入經緯度。"; return; }
    gpsMsg.textContent = "定位中……（瀏覽器會詢問是否允許，請按允許）";
    navigator.geolocation.getCurrentPosition(
      (p) => {
        lat.value = p.coords.latitude.toFixed(4); lon.value = p.coords.longitude.toFixed(4);
        tz.value = String(-new Date().getTimezoneOffset() / 60);
        place.value = "custom";
        gpsMsg.textContent = "已使用目前位置。位置只在你的手機瀏覽器裡計算，不會傳送到任何地方。";
        recompute();
      },
      (e) => { gpsMsg.textContent = e.code === 1 ? "你沒有允許定位。可以改從清單選地點，或自己輸入經緯度。" : "抓不到位置，請稍後再試，或自己輸入經緯度。"; },
      { enableHighAccuracy: false, timeout: 15000, maximumAge: 60000 }
