    // 太陽路徑（顏色：白天黃白、黃金時刻橘、藍調藍）
    const pathCol = (alt: number) => alt > 6 ? "#fff3b0" : alt > -4 ? "#ffa726" : alt > -6.5 ? "#6ea8ff" : "rgba(255,255,255,.18)";
    ctx.lineWidth = 4; ctx.lineCap = "round";
    const P = scene.path;
    for (let i = 1; i < P.length; i++) {
      if (P[i].alt < -10 || P[i - 1].alt < -10) continue;
      const a = project(P[i - 1].az, P[i - 1].alt), b = project(P[i].az, P[i].alt);
