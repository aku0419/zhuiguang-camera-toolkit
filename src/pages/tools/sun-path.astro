    let prev: any = null;
    ctx.beginPath();
    for (let az = 0; az <= 360; az += 2) {
      const q = project(az, 0);
      if (q.vis && prev && prev.vis && Math.abs(q.x - prev.x) < W) ctx.lineTo(q.x, q.y); else if (q.vis) ctx.moveTo(q.x, q.y);
      prev = q;
    }
    ctx.stroke(); ctx.setLineDash([]);
    // 方位文字
    ctx.font = "bold 15px sans-serif"; ctx.textAlign = "center"; ctx.textBaseline = "bottom";
    for (const [n, a] of [["北", 0], ["東北", 45], ["東", 90], ["東南", 135], ["南", 180], ["西南", 225], ["西", 270], ["西北", 315]] as const) {
