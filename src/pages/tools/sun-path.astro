      const q = project(...dir(p.az, p.alt));
      ctx.beginPath(); ctx.arc(q.x, q.y, 2.6, 0, 7); ctx.fillStyle = "#ffb000"; ctx.fill();
      if (h % 2 === 0) { ctx.fillStyle = "#ffd36b"; ctx.fillText(`${h}h`, q.x + 5, q.y - 5); }
    }
    // 現在的太陽：連到地面的投影線
    const minute = Number(slider.value);
    const pos = sunPosition(t.start + minute * 60000, la, lo);
    if (pos.altitude > -0.833) {
      const sq = project(...dir(pos.azimuth, pos.altitude)), gq = project(...dir(pos.azimuth, 0)), oq = project(0, 0, 0);
      ctx.setLineDash([3, 3]);
      ctx.beginPath(); ctx.moveTo(sq.x, sq.y); ctx.lineTo(gq.x, gq.y); ctx.strokeStyle = "rgba(255,230,150,.6)"; ctx.lineWidth = 1; ctx.stroke();
      ctx.beginPath(); ctx.moveTo(oq.x, oq.y); ctx.lineTo(gq.x, gq.y); ctx.stroke();
      ctx.setLineDash([]);
      const r = 9 * Math.min(1.5, Math.max(0.75, sq.k / 118));
