  }

  function arDraw() {
    if (!arActive) return;
    arRaf = requestAnimationFrame(arDraw);
    const dpr = window.devicePixelRatio || 1;
    const W = arCanvas.clientWidth, H = arCanvas.clientHeight;
    if (arCanvas.width !== Math.round(W * dpr)) { arCanvas.width = Math.round(W * dpr); arCanvas.height = Math.round(H * dpr); }
    const ctx = arCanvas.getContext("2d")!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);
    if (!scene) return;
    const { R, sensor, camAz, camAlt } = arPose();
    const fovLong = 2 * Math.atan(18 / Number(arLens.value));         // 手機畫面「長邊」的視角
    const f = (Math.max(W, H) / 2) / Math.tan(fovLong / 2);
    const ang = screenAngle();
    // 地球方向 → 螢幕座標
    const project = (az: number, alt: number) => {
      const a = az * DEG, h = alt * DEG;
      const ex = Math.sin(a) * Math.cos(h), ey = Math.cos(a) * Math.cos(h), ez = Math.sin(h);
      const dx = R[0][0] * ex + R[1][0] * ey + R[2][0] * ez;
      const dy = R[0][1] * ex + R[1][1] * ey + R[2][1] * ez;
      const dz = R[0][2] * ex + R[1][2] * ey + R[2][2] * ez;
