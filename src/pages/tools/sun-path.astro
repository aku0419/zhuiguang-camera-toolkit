    for (const [ms, label, col] of [[scene.t.sunrise, "日出", "#ffa24d"], [scene.t.sunset, "日落", "#ff5a4d"]] as const) {
      if (ms == null) continue;
      const pos = sunPosition(ms, scene.la, scene.lo), q = project(pos.azimuth, 0);
      if (!onScreen(q)) continue;
      ctx.beginPath(); ctx.moveTo(q.x, q.y); ctx.lineTo(q.x, q.y - 30); ctx.strokeStyle = col; ctx.lineWidth = 3; ctx.stroke();
      ctx.font = "bold 14px sans-serif"; ctx.textAlign = "center"; ctx.textBaseline = "bottom"; ctx.fillStyle = col; ctx.shadowColor = "#000"; ctx.shadowBlur = 4;
      ctx.fillText(`${label} ${fmtClock(ms, scene.z)}`, q.x, q.y - 33); ctx.shadowBlur = 0;
    }

    // 目前選的時間的太陽
    const minute = Number(arSlider.value);
    const sun = sunPosition(scene.t.start + minute * 60000, scene.la, scene.lo);
    const sq = project(sun.azimuth, sun.altitude);
    if (onScreen(sq)) {
      const g = ctx.createRadialGradient(sq.x, sq.y, 2, sq.x, sq.y, 46);
      g.addColorStop(0, "rgba(255,240,170,.95)"); g.addColorStop(1, "rgba(255,200,60,0)");
      ctx.beginPath(); ctx.arc(sq.x, sq.y, 46, 0, 7); ctx.fillStyle = g; ctx.fill();
      ctx.beginPath(); ctx.arc(sq.x, sq.y, 13, 0, 7); ctx.fillStyle = "#ffe08a"; ctx.fill(); ctx.strokeStyle = "#e8890c"; ctx.lineWidth = 3; ctx.stroke();
      ctx.font = "bold 14px sans-serif"; ctx.textAlign = "center"; ctx.textBaseline = "top"; ctx.fillStyle = "#fff"; ctx.shadowColor = "#000"; ctx.shadowBlur = 4;
      ctx.fillText(`${arClock.textContent}　高度 ${fmt(sun.altitude, 0)}°`, sq.x, sq.y + 18); ctx.shadowBlur = 0;
    } else {
      // 太陽不在畫面裡：在邊緣畫箭頭指方向
      const dAz = angDiff(sun.azimuth, camAz), dAlt = sun.altitude - camAlt;
      const ax = Math.max(-1, Math.min(1, dAz / 40)), ay = Math.max(-1, Math.min(1, -dAlt / 40));
      const len = Math.hypot(ax, ay) || 1;
      const ex = W / 2 + (ax / len) * (W / 2 - 34), ey = H / 2 + (ay / len) * (H / 2 - 120);
      const rot = Math.atan2(ay, ax);
      ctx.save(); ctx.translate(ex, ey); ctx.rotate(rot);
      ctx.beginPath(); ctx.moveTo(18, 0); ctx.lineTo(-12, -13); ctx.lineTo(-12, 13); ctx.closePath(); ctx.fillStyle = "#ffd54f"; ctx.fill(); ctx.restore();
    }
    // 畫面中央十字
    ctx.strokeStyle = "rgba(255,255,255,.7)"; ctx.lineWidth = 1.5; ctx.beginPath();
    ctx.moveTo(W / 2 - 10, H / 2); ctx.lineTo(W / 2 + 10, H / 2); ctx.moveTo(W / 2, H / 2 - 10); ctx.lineTo(W / 2, H / 2 + 10); ctx.stroke();

    const dAz = angDiff(sun.azimuth, camAz);
    const where = sun.altitude < -0.833 ? "太陽在地平線下" : onScreen(sq) ? "太陽在畫面裡" : `太陽在你的${dAz > 0 ? "右" : "左"}邊 ${fmt(Math.abs(dAz), 0)}°、${sun.altitude - camAlt > 0 ? "上" : "下"}方 ${fmt(Math.abs(sun.altitude - camAlt), 0)}°`;
    arInfo.textContent = `面向 ${compassName(camAz)} ${fmt(camAz, 0)}°　仰角 ${camAlt >= 0 ? "+" : ""}${fmt(camAlt, 0)}°　${where}`;
    arHint.textContent = sensor ? "圖上的太陽路徑，是這個地點與時間太陽會經過的位置。如果和真正的太陽差一段距離，請把畫面中央對準真正的太陽，按「校正」。" : "沒有收到方向感測器的資料，目前用手指左右、上下拖曳來看四周。";
  }

  const syncArClock = () => { const m = Number(arSlider.value); arClock.textContent = `${pad(Math.floor(m / 60))}:${pad(m % 60)}`; };
  arSlider.addEventListener("input", () => { slider.value = arSlider.value; syncArClock(); refresh(); });
  document.getElementById("ar-now")!.addEventListener("click", () => {
    date.value = todayStr(); recompute(); slider.value = String(nowMinute()); arSlider.value = slider.value; syncArClock(); refresh();
  });
  // 沒有感測器時，用手指拖曳看四周
  let arDrag: { x: number; y: number } | null = null;
  arCanvas.addEventListener("pointerdown", (e) => { arDrag = { x: e.clientX, y: e.clientY }; arCanvas.setPointerCapture(e.pointerId); });
  arCanvas.addEventListener("pointermove", (e) => {
    if (!arDrag || oriAlpha != null) return;
    manualYaw = (manualYaw - (e.clientX - arDrag.x) * 0.15 + 360) % 360;
    manualPitch = Math.max(-80, Math.min(85, manualPitch + (e.clientY - arDrag.y) * 0.15));
    arDrag = { x: e.clientX, y: e.clientY };
  });
  arCanvas.addEventListener("pointerup", () => { arDrag = null; });

  async function openStream(deviceId?: string) {
    if (arStream) arStream.getTracks().forEach((t) => t.stop());
    const video: MediaTrackConstraints = deviceId ? { deviceId: { exact: deviceId } } : { facingMode: { ideal: "environment" }, width: { ideal: 1920 }, height: { ideal: 1080 } };
    arStream = await navigator.mediaDevices.getUserMedia({ video, audio: false });
    arVideo.srcObject = arStream;
    await arVideo.play().catch(() => {});
  }
  // 選了超廣角或望遠，就盡量改用手機上對應的鏡頭（瀏覽器有提供才會成功）
  arLens.addEventListener("change", async () => {
    try {
      const devs = (await navigator.mediaDevices.enumerateDevices()).filter((d) => d.kind === "videoinput");
      const v = Number(arLens.value);
      const want = v <= 13 ? /ultra|超廣角|0\.5/i : v >= 48 ? /tele|望遠/i : /back camera|後置相機|rear camera|後鏡頭(?!.*(ultra|tele))/i;
      const hit = devs.find((d) => want.test(d.label) && !(v === 24 && /ultra|tele|超廣角|望遠/i.test(d.label)));
      if (hit) await openStream(hit.deviceId);
    } catch { /* 切不過去就維持原本的鏡頭，只改視角假設 */ }
  });

  document.getElementById("ar-open")!.addEventListener("click", async () => {
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) { gpsMsg.textContent = "這個瀏覽器不能使用相機，請改用手機的 Safari 或 Chrome。"; return; }
    arEl.hidden = false; document.body.style.overflow = "hidden";
    arInfo.textContent = "請在跳出的詢問中允許相機與動作方向……";
    date.value = todayStr(); recompute(); slider.value = String(nowMinute()); arSlider.value = slider.value; syncArClock();
    await enableSensors();
    try { await openStream(); }
    catch { arInfo.textContent = "沒有取得相機權限。請到手機的設定允許這個網站使用相機後，再試一次。"; return; }
    arActive = true; cancelAnimationFrame(arRaf); arDraw();
  });
  document.getElementById("ar-close")!.addEventListener("click", () => {
    arActive = false; cancelAnimationFrame(arRaf);
    if (arStream) { arStream.getTracks().forEach((t) => t.stop()); arStream = null; }
    arVideo.srcObject = null; arEl.hidden = true; document.body.style.overflow = "";
  });
  document.getElementById("ar-calib")!.addEventListener("click", () => {
    if (oriAlpha == null) { arHint.textContent = "沒有方向感測器的資料，沒辦法校正。"; return; }
    const real = sunPosition(Date.now(), num(lat), num(lon));
    if (real.altitude < 0) { arHint.textContent = "現在太陽在地平線下，沒辦法對著太陽校正。"; return; }
    const { camAz } = arPose();
    offset = ((offset + angDiff(real.azimuth, camAz)) + 540) % 360 - 180;
    try { localStorage.setItem("zg-compass-offset", String(offset)); } catch { /* 不能存也沒關係 */ }
    arHint.textContent = `已校正（修正 ${fmt(offset, 0)}°）。`;
  });


  recompute();
</script>
