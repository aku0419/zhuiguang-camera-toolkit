  // 向使用者要求方向感測器的權限並開始聆聽。回傳是否可用（桌機沒有感測器會是 false）
  async function enableSensors(): Promise<boolean> {
    const DOE: any = (window as any).DeviceOrientationEvent;
    if (!DOE) return false;
    try {
      if (typeof DOE.requestPermission === "function") {
        const r = await DOE.requestPermission();
        if (r !== "granted") return false;
      }
    } catch { return false; }
    if (!listening) {
      listening = true;
      window.addEventListener("deviceorientationabsolute", onOrientation as any, true);
      window.addEventListener("deviceorientation", onOrientation as any, true);
    }
    return true;
  }

  compassBtn.addEventListener("click", async () => {
    if (!(window as any).DeviceOrientationEvent) { compassInfo.textContent = "這個瀏覽器沒有方向感測器，請改用手機。"; return; }
    if (!(await enableSensors())) { compassInfo.textContent = "你沒有允許使用動作與方向（或無法取得權限）。可以到手機的設定 → Safari 再開啟。"; return; }
    compassBtn.textContent = "指南針已開啟";
    calibBtn.hidden = false;
    compassInfo.textContent = "請把手機拿平，畫出 8 字形晃一下，讓指南針校準……";
    setTimeout(() => { if (rawHeading == null) compassInfo.textContent = "沒有收到方向資料。這支手機或瀏覽器可能不支援，或感測器被關閉。"; }, 3000);
  });

  calibBtn.addEventListener("click", () => {
    if (rawHeading == null) return;
    const p = sunPosition(Date.now(), num(lat), num(lon));
    if (p.altitude < 0) { compassInfo.textContent = "現在太陽在地平線下，沒辦法對著太陽校正。"; return; }
    offset = angDiff(p.azimuth, rawHeading);
    try { localStorage.setItem("zg-compass-offset", String(offset)); } catch { /* 不能存也沒關係 */ }
    heading = (rawHeading + offset + 360) % 360; yaw = heading;
    compassInfo.textContent = `已校正（修正 ${fmt(offset, 0)}°）。`;
    refresh();
  });

  // ============ AR 模式：相機畫面疊上太陽軌跡 ============
  const arEl = document.getElementById("ar")!;
  const arVideo = document.getElementById("ar-video") as HTMLVideoElement;
  const arCanvas = document.getElementById("ar-canvas") as HTMLCanvasElement;
  const arInfo = document.getElementById("ar-info")!, arHint = document.getElementById("ar-hint")!;
  const arSlider = $("ar-slider"), arClock = document.getElementById("ar-clock")!, arLens = $("ar-lens");
  let arActive = false, arStream: MediaStream | null = null, arRaf = 0;
  let manualYaw = 180, manualPitch = 15;   // 沒有感測器時，用手指拖曳看四周

  // 裝置座標 → 地球座標的旋轉矩陣（W3C：Rz(alpha)·Rx(beta)·Ry(gamma)）
  function rotation(alphaDeg: number, betaDeg: number, gammaDeg: number) {
    const a = alphaDeg * DEG, b = betaDeg * DEG, g = gammaDeg * DEG;
    const ca = Math.cos(a), sa = Math.sin(a), cb = Math.cos(b), sb = Math.sin(b), cg = Math.cos(g), sg = Math.sin(g);
    return [
      [ca * cg - sa * sb * sg, -cb * sa, cg * sa * sb + ca * sg],
      [cg * sa + ca * sb * sg, ca * cb, sa * sg - ca * cg * sb],
      [-cb * sg, sb, cb * cg],
    ];
  }
  const screenAngle = () => ((screen.orientation && screen.orientation.angle) || (window as any).orientation || 0 + 360) % 360;

  function arPose() {
    let alpha: number, beta: number, gamma: number, sensor = false;
    if (oriAlpha != null && oriBeta != null) {
      alpha = (oriAlpha - offset + 360) % 360; beta = oriBeta; gamma = oriGamma ?? 0; sensor = true;
    } else {
      alpha = (360 - manualYaw + 360) % 360; beta = 90 + manualPitch; gamma = 0;
    }
    const R = rotation(alpha, beta, gamma);
    // 相機（手機背面）看的方向 ＝ 裝置的 −z 軸
    const cx = -R[0][2], cy = -R[1][2], cz = -R[2][2];
