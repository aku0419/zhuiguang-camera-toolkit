      g.addColorStop(0, "rgba(255,240,170,.9)"); g.addColorStop(1, "rgba(255,200,60,0)");
      ctx.beginPath(); ctx.arc(sq.x, sq.y, r * 2.2, 0, 7); ctx.fillStyle = g; ctx.fill();
      ctx.beginPath(); ctx.arc(sq.x, sq.y, r, 0, 7); ctx.fillStyle = "#ffe08a"; ctx.fill();
    }
    // 你的位置（圓心）與面對的方向
    const o = project(0, 0, 0);
    ctx.beginPath(); ctx.arc(o.x, o.y, 4, 0, 7); ctx.fillStyle = "#35c46a"; ctx.fill();
    if (heading != null) {
      const q = project(...dir(heading, 0, 0.5));
      ctx.beginPath(); ctx.moveTo(o.x, o.y); ctx.lineTo(q.x, q.y); ctx.strokeStyle = "#35c46a"; ctx.lineWidth = 3; ctx.stroke();
      ctx.beginPath(); ctx.arc(q.x, q.y, 4, 0, 7); ctx.fill();
    }
