---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { TOOLS } from "../../data/site.js";
---
<BaseLayout title="攝影工具" description="免費攝影計算工具：快門角度、升降格、等效焦段、錄影容量、記憶卡可錄時間。手機就能用。" section="tools">
  <p class="eyebrow">Tools</p>
  <h1>攝影工具</h1>
  <p class="lead">選一個工具，輸入數字就有答案。</p>
  <div class="grid">
    {TOOLS.map((t) => (
      <a class="card" href={t.href}>
        <h3>{t.name}</h3>
        <p>{t.q}</p>
      </a>
    ))}
  </div>
  <h2>第二階段預計加入</h2>
  <p class="lead">ND 減光、畫面比例、底片長度、景深、曝光級數。</p>
</BaseLayout>
