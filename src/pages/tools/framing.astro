---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolHead from "../../components/ToolHead.astro";
import Chips from "../../components/Chips.astro";
import { FORMATS } from "../../lib/calc.js";
import { camerasForTools } from "../../lib/cameras.js";
const RATIOS = [
  { v: "open", t: "Open Gate（整個感光元件）" }, { v: 16 / 9, t: "16:9（一般影片）" }, { v: 17 / 9, t: "17:9（DCI 4K）" },
  { v: 2.39, t: "2.39:1（電影寬銀幕）" }, { v: 2, t: "2:1" }, { v: 1.85, t: "1.85:1" },
  { v: 4 / 3, t: "4:3" }, { v: 1.5, t: "3:2（照片）" }, { v: 1, t: "1:1（正方形）" },
  { v: 4 / 5, t: "4:5（直式社群）" }, { v: 9 / 16, t: "9:16（直式影片）" },
];
const brands = [...new Set(camerasForTools.map((c) => c.brand))];
---
<BaseLayout title="構圖取景" description="用手機相機先看畫面：選攝影機、鏡頭組和焦段，在手機畫面上疊出那顆鏡頭拍出來的範圍框。選機位、決定用哪顆鏡頭很好用。" section="tools">
  <ToolHead title="構圖取景" question="這顆鏡頭拍出來會是多大的畫面？用手機先看。" />
  <div class="tool">
    <h2 class="fr-h">1. 攝影機</h2>
    <div class="field">
      <label for="cbrand">品牌</label>
      <select id="cbrand">
        <option value="">全部品牌</option>
        {brands.map((b) => <option value={b}>{b}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="cam">機型</label>
      <select id="cam"><option value="">不指定（用下面的片幅）</option></select>
      <script type="application/json" id="cam-data" set:html={JSON.stringify(camerasForTools.map((c) => ({ slug: c.slug, name: c.name, brand: c.brand, lens_mount: c.lens_mount, width_mm: c.width_mm, height_mm: c.height_mm, crop_factor: c.crop_factor, format_id: c.format_id })))} />
    </div>
    <div class="field" id="fmt-field">
      <label for="fmt">相機片幅</label>
      <select id="fmt">{FORMATS.map((f) => <option value={f.id} data-factor={f.factor}>{f.label}</option>)}</select>
    </div>

    <h2 class="fr-h">2. 鏡頭（選填）</h2>
    <div class="field">
      <label for="lbrand">鏡頭品牌</label>
      <select id="lbrand"><option value="">不指定（自己選焦段）</option></select>
    </div>
    <div class="field" id="lseries-field" hidden>
      <label for="lseries">系列（鏡頭組）</label>
      <select id="lseries"></select>
    </div>
    <div class="field" id="llens-field" hidden>
      <label for="llens">鏡頭</label>
      <select id="llens"></select>
    </div>
    <label class="check" id="compat-row"><input type="checkbox" id="compat" checked /> 只列出接環能裝上這台相機的鏡頭</label>
    <p class="hint" id="lens-note" aria-live="polite"></p>

    <h2 class="fr-h">3. 畫面與手機</h2>
    <div class="field">
      <label for="ratio">錄影畫面比例</label>
      <select id="ratio">{RATIOS.map((r) => <option value={r.v}>{r.t}</option>)}</select>
    </div>
    <div class="field">
      <label for="phone">手機鏡頭（35mm 等效焦段）</label>
      <div class="inrow"><input id="phone" type="number" inputmode="decimal" min="8" max="300" step="any" value="24" /><span class="unit">mm</span></div>
      <Chips label="手機鏡頭" values={[13, 24, 48, 77, 120]} />
      <span class="hint">一般手機的主鏡頭約 24mm，超廣角約 13mm，望遠 2、3、5 倍約 48、77、120mm。</span>
    </div>
    <div class="field">
      <span class="label">要顯示的焦段框</span>
      <div class="chips" id="focals" role="group" aria-label="要顯示的焦段框"></div>
    </div>
    <button type="button" class="btn primary" id="fr-open">開啟手機相機取景</button>
    <p class="hint" id="fr-msg" aria-live="polite"></p>
    <ul class="notes">
      <li>請<b>橫拿手機</b>，框會比較好看；直拿也能用。</li>
      <li>這個工具只模擬<b>畫面範圍</b>（焦段與視角）。景深、虛化、亮度是手機鏡頭自己的，不會因為你選了某個光圈或鏡頭而改變，這些要看真的鏡頭，或用「景深」工具估算。</li>
      <li>範圍框是<b>估算</b>：手機鏡頭的實際視角會因機型、防手震與錄影裁切有些差異。如果框和你用真的鏡頭拍出來的不一樣，可以改上面的「手機鏡頭」數字微調。</li>
      <li>選了相機會用那台的感光元件尺寸；選了「Open Gate」就是用整個感光元件的比例。相機開啟裁切模式（例如 4K 120p）時，實際範圍會更窄，這裡不會算進去。</li>
      <li>鏡頭資料來自逐光的鏡頭資料庫，只列出有收錄的鏡頭。接環相容與「可能暗角」只是提醒，實際以原廠說明為準。</li>
      <li>相機畫面只在你的手機螢幕上顯示，不錄影、不儲存，也不會傳送到任何地方。取景時按「截圖」，才會在你的手機裡產生一張帶著目前設定說明的圖片，由你自己決定存到哪裡。</li>
    </ul>
  </div>

  <div class="fr" id="fr" hidden>
    <video id="fr-video" playsinline muted autoplay></video>
    <canvas id="fr-canvas"></canvas>
    <div class="fr-top">
      <p id="fr-info"></p>
      <div class="fr-tr">
        <select id="fr-ratio" aria-label="畫面比例">{RATIOS.map((r) => <option value={r.v}>{r.t}</option>)}</select>
        <div class="fr-btns"><button type="button" id="fr-shot">截圖</button><button type="button" id="fr-close">關閉</button></div>
      </div>
    </div>
    <p class="fr-toast" id="fr-toast" hidden></p>
    <div class="fr-bottom">
      <div class="fr-row" id="fr-slider-row">
        <label>焦段 <b id="fr-focal">50mm</b></label>
        <input id="fr-slider" type="range" min="0" max="1000" step="1" />
      </div>
      <div class="fr-chips" id="fr-chips"></div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .fr{position:fixed;inset:0;z-index:100;background:#000;color:#fff;overflow:hidden}
  .fr video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .fr canvas{position:absolute;inset:0;width:100%;height:100%;touch-action:none}
  .fr-top{position:absolute;top:0;left:0;right:0;display:flex;justify-content:space-between;align-items:flex-start;gap:8px;padding:calc(env(safe-area-inset-top) + 10px) 12px 8px;background:linear-gradient(rgba(0,0,0,.55),rgba(0,0,0,0))}
  .fr-top p{margin:0;font-size:14px;text-shadow:0 1px 3px #000}
  .fr-top button,.fr select{white-space:nowrap;flex:none;background:rgba(0,0,0,.55);color:#fff;border:1px solid rgba(255,255,255,.5);border-radius:8px;padding:8px 12px;font-size:14px;font-weight:700;cursor:pointer}
  .fr-bottom{position:absolute;left:0;right:0;bottom:0;display:flex;flex-direction:column;gap:8px;padding:28px 12px calc(env(safe-area-inset-bottom) + 12px);background:linear-gradient(rgba(0,0,0,0),rgba(0,0,0,.7))}
  .fr-row{display:flex;align-items:center;gap:10px}
  .fr-row label{font-size:14px;white-space:nowrap}
  .fr-row input{flex:1;min-width:0;accent-color:var(--accent)}
  .fr-tr{display:flex;flex-direction:column;align-items:flex-end;gap:6px}
  .fr-btns{display:flex;gap:6px}
  .fr-toast{position:absolute;left:50%;bottom:140px;transform:translateX(-50%);margin:0;background:rgba(0,0,0,.75);color:#fff;padding:8px 16px;border-radius:999px;font-size:14px}
  .fr-tr select{max-width:150px;font-weight:500;width:auto}
  @media (max-height:500px){.fr-tr{flex-direction:row}.fr-bottom{padding-top:16px}}
  .fr-chips{display:flex;gap:6px;overflow-x:auto;padding-bottom:2px}
  .fr-chips button{flex:none;border:1px solid rgba(255,255,255,.5);background:rgba(0,0,0,.55);color:#fff;border-radius:16px;padding:5px 12px;font-size:14px;font-family:var(--mono);cursor:pointer}
  .fr-chips button[aria-pressed="true"]{background:#fff;color:#000;border-color:#fff}
  .fr-h{font-size:16px;margin:18px 0 10px}
  .fr-h:first-child{margin-top:0}
  .check{display:flex;align-items:center;gap:8px;font-size:14px;margin:-6px 0 10px}
  .check input{width:18px;height:18px}
</style>

<script>
  import { framingBox, FORMATS, fmt, lensMayVignette } from "../../lib/calc.js";
  import { bindChips, num } from "../../lib/ui.js";
  type Cam = { slug: string; name: string; brand: string; lens_mount: string; width_mm: number | null; height_mm: number | null; crop_factor: number | null; format_id: string | null };
  type Lens = { s: string; b: string; r: string; m: string; t: string; f1: number; f2: number; a: number; at: string; mt: string; mm: string[]; c: string; ic: number | null };
  const $ = (id: string) => document.getElementById(id)!;
  const sel = (id: string) => $(id) as HTMLSelectElement;
  const cbrand = sel("cbrand"), camSel = sel("cam"), fmtSel = sel("fmt"), ratio = sel("ratio"), phone = $("phone") as HTMLInputElement;
  const lbrand = sel("lbrand"), lseries = sel("lseries"), llens = sel("llens");
  const compat = $("compat") as HTMLInputElement, compatRow = $("compat-row"), lensNote = $("lens-note");
  const fmtField = $("fmt-field"), msg = $("fr-msg"), focalsBox = $("focals");
  const overlay = $("fr"), video = $("fr-video") as HTMLVideoElement, canvas = $("fr-canvas") as HTMLCanvasElement;
  const info = $("fr-info"), focalOut = $("fr-focal"), slider = $("fr-slider") as HTMLInputElement, sliderRow = $("fr-slider-row");
  const frRatio = sel("fr-ratio"), frChips = $("fr-chips");

  const cams: Cam[] = JSON.parse($("cam-data").textContent || "[]");
  let lensesAll: Lens[] = [];
  const q = new URLSearchParams(location.search);

  // ---- 相機 ----
  const curCam = () => cams.find((c) => c.slug === camSel.value) || null;
  function fillCams() {
    const keep = camSel.value;
    camSel.innerHTML = '<option value="">不指定（用下面的片幅）</option>';
    for (const c of cams.filter((c) => !cbrand.value || c.brand === cbrand.value)) camSel.append(new Option(c.name, c.slug));
    camSel.value = cams.some((c) => c.slug === keep && (!cbrand.value || c.brand === cbrand.value)) ? keep : "";
  }
  function sensor() {
    const cam = curCam();
    const has = cam && cam.width_mm && cam.height_mm;
    if (cam && !has && cam.format_id && !fmtSel.dataset.touched) fmtSel.value = cam.format_id;
    fmtField.hidden = !!has;
    if (has) return { w: cam!.width_mm as number, h: cam!.height_mm as number, name: cam!.name, factor: Math.hypot(36, 24) / Math.hypot(cam!.width_mm as number, cam!.height_mm as number) };
    const k = cam && cam.crop_factor ? cam.crop_factor : FORMATS.find((x) => x.id === fmtSel.value)!.factor;
    return { w: 36 / k, h: 24 / k, name: cam ? cam.name : "", factor: k };
  }
  const compatible = (l: Lens, c: Cam | null) => !!c && !!c.lens_mount && l.mm.some((m) => c.lens_mount.includes(m));

  // ---- 鏡頭 ----
  const GENERIC = [14, 18, 24, 35, 50, 85, 135, 200];
  let opts: number[] = GENERIC;           // 可選的焦段
  let range: [number, number] | null = [8, 400]; // 滑桿範圍（只有定焦組時是 null）
  const shown = new Set<number>([35, 50, 85]);
  let picked: Lens[] = [];

  const lensPool = () => lensesAll.filter((l) => !compat.checked || !curCam() || compatible(l, curCam()));
  function fillLensBrands() {
    const keep = lbrand.value, pool = lensPool();
    lbrand.innerHTML = '<option value="">不指定（自己選焦段）</option>';
    for (const b of [...new Set(pool.map((l) => l.b))]) lbrand.append(new Option(b, b));
    lbrand.value = pool.some((l) => l.b === keep) ? keep : "";
    fillSeries();
  }
  function fillSeries() {
    $("lseries-field").hidden = !lbrand.value;
    const keep = lseries.value, pool = lensPool().filter((l) => l.b === lbrand.value);
    lseries.innerHTML = "";
    for (const r of [...new Set(pool.map((l) => l.r))]) lseries.append(new Option(`${r}（${pool.filter((l) => l.r === r).length} 支）`, r));
    if ([...lseries.options].some((o) => o.value === keep)) lseries.value = keep;
    fillLens();
  }
  function fillLens() {
    $("llens-field").hidden = !lbrand.value;
    const keep = llens.value;
    const pool = lensPool().filter((l) => l.b === lbrand.value && l.r === lseries.value).sort((a, b) => a.f1 - b.f1 || a.a - b.a);
    llens.innerHTML = "";
    llens.append(new Option(`整組（${pool.length} 支）`, ""));
    for (const l of pool) llens.append(new Option(l.m, l.s));
    if ([...llens.options].some((o) => o.value === keep)) llens.value = keep;
    applyLens(pool);
  }
  function applyLens(pool: Lens[]) {
    picked = !lbrand.value ? [] : llens.value ? pool.filter((l) => l.s === llens.value) : pool;
    if (picked.length === 0) {
      opts = GENERIC; range = [8, 400]; shown.clear(); [35, 50, 85].forEach((f) => shown.add(f));
    } else {
      const primes = [...new Set(picked.filter((l) => l.t === "prime").map((l) => l.f1))].sort((a, b) => a - b);
      const zooms = picked.filter((l) => l.t === "zoom");
      const set = new Set(primes);
      if (zooms.length) {
        const lo = Math.min(...zooms.map((z) => z.f1)), hi = Math.max(...zooms.map((z) => z.f2));
        set.add(lo); set.add(hi);
        for (const f of [14, 18, 24, 28, 35, 50, 70, 85, 100, 135, 200, 300]) if (f > lo && f < hi) set.add(f);
        range = [lo, hi];
      } else range = null;
      opts = [...set].sort((a, b) => a - b);
      shown.clear();
      const pick = opts.length <= 6 ? opts : opts.filter((_, i) => i % Math.ceil(opts.length / 5) === 0);
      pick.forEach((f) => shown.add(f));
    }
    renderFocals(); renderNote();
  }
  function renderNote() {
    const s = sensor(), cam = curCam();
    const parts: string[] = [];
    if (picked.length) {
      const bad = picked.filter((l) => lensMayVignette(l.c, l.ic, s.w, s.h));
      if (bad.length) parts.push(picked.length === 1 ? `提醒：這顆鏡頭標示的涵蓋範圍（${picked[0].c}）可能比這台相機的感光元件小，邊緣可能暗角。` : `提醒：這組有 ${bad.length} 支鏡頭的涵蓋範圍可能比這台相機的感光元件小，邊緣可能暗角。`);
      if (cam && !compat.checked) {
        const no = picked.filter((l) => !compatible(l, cam));
        if (no.length) parts.push(`${no.length === picked.length ? "這" : `其中 ${no.length} 支`}鏡頭的接環和這台相機不同，需要轉接環。`);
      }
    }
    lensNote.textContent = parts.join(" ");
  }
  function renderFocals() {
    focalsBox.innerHTML = "";
    for (const f of opts) {
      const b = document.createElement("button");
      b.type = "button"; b.className = "chip"; b.textContent = `${f}mm`;
      b.setAttribute("aria-pressed", String(shown.has(f)));
      b.addEventListener("click", () => { if (shown.has(f)) shown.delete(f); else shown.add(f); b.setAttribute("aria-pressed", String(shown.has(f))); });
      focalsBox.append(b);
    }
  }
  const lensFor = (f: number) => picked.find((l) => l.t === "prime" && l.f1 === f) || (picked.length === 1 ? picked[0] : null);

  cbrand.addEventListener("change", () => { fillCams(); onCamChange(); });
  camSel.addEventListener("change", () => { onCamChange(); const u = new URL(location.href); if (camSel.value) u.searchParams.set("camera", camSel.value); else u.searchParams.delete("camera"); history.replaceState(null, "", u); });
  function onCamChange() { sensor(); compatRow.hidden = !curCam(); fillLensBrands(); }
  compat.addEventListener("change", fillLensBrands);
  lbrand.addEventListener("change", fillSeries);
  lseries.addEventListener("change", fillLens);
  llens.addEventListener("change", () => fillLens());
  fmtSel.addEventListener("change", () => { fmtSel.dataset.touched = "1"; renderNote(); });
  bindChips(document.querySelector(".chips")!, phone, () => draw());

  // 從網址帶入：?camera=、?lens=（鏡頭代號）
  const camQ = q.get("camera"), lensQ = q.get("lens");
  if (camQ && cams.some((c) => c.slug === camQ)) { cbrand.value = cams.find((c) => c.slug === camQ)!.brand; fillCams(); camSel.value = camQ; }
  else fillCams();
  onCamChange();
  fetch("/framing-data.json").then((r) => r.json()).then((d: Lens[]) => {
    lensesAll = d;
    if (lensQ) {
      const l = d.find((x) => x.s === lensQ);
      if (l) { compat.checked = false; fillLensBrands(); lbrand.value = l.b; fillSeries(); lseries.value = l.r; fillLens(); llens.value = l.s; fillLens(); return; }
    }
    fillLensBrands();
  }).catch(() => { $("lbrand").parentElement!.hidden = true; });

  // ---- 取景 ----
  let active = 50;
  const FMIN = () => (range ? range[0] : opts[0]), FMAX = () => (range ? range[1] : opts[opts.length - 1]);
  const fromSlider = () => Math.round(FMIN() * Math.pow(FMAX() / FMIN(), Number(slider.value) / 1000));
  const toSlider = (f: number) => String(Math.round((Math.log(f / FMIN()) / Math.log(FMAX() / FMIN())) * 1000));

  function buildChips() {
    frChips.innerHTML = "";
    for (const f of opts) {
      const b = document.createElement("button");
      b.type = "button"; b.textContent = `${f}`;
      b.setAttribute("aria-pressed", String(shown.has(f)));
      b.addEventListener("click", () => {
        const on = !shown.has(f);
        if (on) shown.add(f); else shown.delete(f);
        b.setAttribute("aria-pressed", String(on));
        if (on) { active = f; if (range) slider.value = toSlider(f); }
        draw();
      });
      frChips.append(b);
    }
  }
  const aspectNow = (s: { w: number; h: number }) => (frRatio.value === "open" ? s.w / s.h : Number(frRatio.value));

  // 把所有焦段框畫在 W × H 的畫面上（取景畫面與截圖共用）
  function paintFrames(ctx: CanvasRenderingContext2D, W: number, H: number, forShot = false) {
    const s = sensor(), asp = aspectNow(s), eq = num(phone);
    const list = [...new Set([...shown, active])].sort((a, b) => b - a);
    list.sort((a, b) => Number(a === active) - Number(b === active));   // 目前焦段最後畫，疊在最上面
    for (const f of list) {
      const b = framingBox({ focalMm: f, sensorW: s.w, sensorH: s.h, aspect: asp, phoneEq: eq, viewW: W, viewH: H });
      if (!b) continue;
      const isActive = f === active;
      const x = W / 2 - b.w / 2, y = H / 2 - b.h / 2;
      ctx.save();
      if (!isActive) ctx.setLineDash([8, 6]);
      ctx.lineWidth = isActive ? 3 : 1.5;
      ctx.strokeStyle = isActive ? "#ffd54f" : "rgba(255,255,255,.85)";
      ctx.shadowColor = "rgba(0,0,0,.7)"; ctx.shadowBlur = 3;
      ctx.strokeRect(x, y, b.w, b.h);
      ctx.restore();
      if (isActive) {                                  // 目前焦段：畫三分法格線
        ctx.save(); ctx.strokeStyle = "rgba(255,213,79,.5)"; ctx.lineWidth = 1;
        for (let i = 1; i <= 2; i++) {
          ctx.beginPath(); ctx.moveTo(x + (b.w * i) / 3, y); ctx.lineTo(x + (b.w * i) / 3, y + b.h); ctx.moveTo(x, y + (b.h * i) / 3); ctx.lineTo(x + b.w, y + (b.h * i) / 3); ctx.stroke();
        }
        ctx.restore();
      }
      const lx = Math.max(8, Math.min(W - 70, x + 6)), ly = forShot ? Math.max(20, Math.min(H - 20, y + 18)) : Math.max(70, Math.min(H - 130, y + 18));
      ctx.font = `bold ${isActive ? 16 : 13}px sans-serif`; ctx.textAlign = "left"; ctx.textBaseline = "middle";
      ctx.fillStyle = isActive ? "#ffd54f" : "#fff"; ctx.shadowColor = "#000"; ctx.shadowBlur = 4;
      ctx.fillText(`${f}mm`, lx, ly); ctx.shadowBlur = 0;
    }
    if (!forShot) {
      ctx.strokeStyle = "rgba(255,255,255,.6)"; ctx.lineWidth = 1.2; ctx.beginPath();
      ctx.moveTo(W / 2 - 8, H / 2); ctx.lineTo(W / 2 + 8, H / 2); ctx.moveTo(W / 2, H / 2 - 8); ctx.lineTo(W / 2, H / 2 + 8); ctx.stroke();
    }
  }

  // 目前選擇的狀態（取景畫面上方的文字、截圖下方的說明共用）
  function state(W: number, H: number) {
    const s = sensor(), asp = aspectNow(s), eq = num(phone);
    const cur = framingBox({ focalMm: active, sensorW: s.w, sensorH: s.h, aspect: asp, phoneEq: eq, viewW: W, viewH: H });
    const lens = lensFor(active);
    const lensName = lens ? `${lens.b} ${lens.m}` : picked.length ? `${picked[0].b} ${picked[0].r}` : "";
    const eqTxt = Math.abs(s.factor - 1) > 0.03 ? `全片幅等效 ${fmt(active * s.factor, 0)}mm` : "";
    const focalTxt = lensName.includes(`${active}mm`) ? eqTxt : `${active}mm${eqTxt ? `（${eqTxt}）` : ""}`;
    const ratioTxt = frRatio.options[frRatio.selectedIndex].text;
    const zooms = picked.filter((l) => l.t === "zoom");
    const zoomRange = zooms.length ? `${Math.min(...zooms.map((z) => z.f1))}–${Math.max(...zooms.map((z) => z.f2))}mm` : "";
    return {
      s, cur, lensName, focalTxt, ratioTxt, zoomRange,
      line: [s.name || "通用相機", lensName, focalTxt, `水平視角 ${cur ? fmt(cur.hfov, 1) : "—"}°`].filter(Boolean).join("　"),
    };
  }

  function draw() {
    if (overlay.hidden) return;
    const dpr = window.devicePixelRatio || 1;
    const W = canvas.clientWidth, H = canvas.clientHeight;
    if (canvas.width !== Math.round(W * dpr) || canvas.height !== Math.round(H * dpr)) { canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr); }
    const ctx = canvas.getContext("2d")!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, W, H);
    paintFrames(ctx, W, H);
    focalOut.textContent = `${active}mm`;
    info.textContent = state(W, H).line;
  }

  // 截圖：目前相機畫面（跟螢幕上看到的一樣的範圍）＋焦段框，下方加一條寫著目前選擇的說明
  function pad2(n: number) { return String(n).padStart(2, "0"); }
  async function shot() {
    const W = canvas.clientWidth, H = canvas.clientHeight, vw = video.videoWidth, vh = video.videoHeight;
    if (!vw || !vh) { toast("相機畫面還沒準備好，再按一次。"); return; }
    const sc = Math.max(W / vw, H / vh);                  // object-fit: cover 的縮放
    const sw = W / sc, sh = H / sc, sx = (vw - sw) / 2, sy = (vh - sh) / 2;
    const k = sw / W;                                      // 畫面座標 → 截圖像素
    const st = state(W, H);
    const fs = Math.max(16, Math.round(sw / (sw > sh ? 48 : 30)));          // 說明文字大小
    const now = new Date();
    const stamp = `${now.getFullYear()}-${pad2(now.getMonth() + 1)}-${pad2(now.getDate())} ${pad2(now.getHours())}:${pad2(now.getMinutes())}`;
    const items: { t: string; head?: boolean }[] = [
      { t: [st.s.name || "通用相機", st.lensName].filter(Boolean).join("　"), head: true },
      { t: [st.focalTxt, `水平視角 ${st.cur ? fmt(st.cur.hfov, 1) : "—"}°`].filter(Boolean).join("　") },
      ...(st.zoomRange ? [{ t: `鏡頭焦段範圍 ${st.zoomRange}` }] : []),
      { t: `畫面比例 ${st.ratioTxt}　感光元件 ${fmt(st.s.w, 1)} × ${fmt(st.s.h, 1)} mm` },
      { t: `顯示焦段 ${[...new Set([...shown, active])].sort((a, b) => a - b).map((f) => `${f}mm`).join("、")}` },
      { t: `手機鏡頭估算 ${fmt(num(phone), 0)}mm　${stamp}　逐光` },
    ];
    const font = (head?: boolean) => `${head ? "bold " : ""}${fs}px "Chiron Hei HK", -apple-system, "PingFang TC", sans-serif`;
    const out = document.createElement("canvas");
    out.width = Math.round(sw);
    const c = out.getContext("2d")!;
    // 太長的行自動換行
    const maxW = out.width - fs * 1.2;
    const rows: { t: string; head?: boolean }[] = [];
    for (const it of items) {
      c.font = font(it.head);
      let cur = "";
      for (const ch of it.t) {
        if (c.measureText(cur + ch).width > maxW && cur) { rows.push({ t: cur, head: it.head }); cur = ch; } else cur += ch;
      }
      if (cur) rows.push({ t: cur, head: it.head });
    }
    const lh = fs * 1.45, band = Math.round(lh * rows.length + fs);
    out.height = Math.round(sh) + band;       // 改尺寸會清空畫布，所以要在這之後才開始畫
    c.drawImage(video, sx, sy, sw, sh, 0, 0, out.width, Math.round(sh));
    c.save(); c.scale(k, k); paintFrames(c, W, H, true); c.restore();
    c.fillStyle = "#14181d"; c.fillRect(0, Math.round(sh), out.width, band);
    c.textBaseline = "top"; c.textAlign = "left";
    rows.forEach((r, n) => { c.font = font(r.head); c.fillStyle = r.head ? "#ffd54f" : "#e7ebef"; c.fillText(r.t, fs * 0.6, Math.round(sh) + fs * 0.5 + n * lh); });
    const blob: Blob | null = await new Promise((res) => out.toBlob(res, "image/png"));
    if (!blob) { toast("截圖失敗，請再試一次。"); return; }
    const d = new Date(), name = `逐光取景-${d.getFullYear()}${pad2(d.getMonth() + 1)}${pad2(d.getDate())}-${pad2(d.getHours())}${pad2(d.getMinutes())}${pad2(d.getSeconds())}.png`;
    const file = new File([blob], name, { type: "image/png" });
    try {
      if ((navigator as any).canShare?.({ files: [file] })) { await (navigator as any).share({ files: [file] }); toast("已產生截圖"); return; }
    } catch (e: any) { if (e && e.name === "AbortError") return; }
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob); a.download = name; document.body.append(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 10000);
    toast("已下載截圖");
  }
  const toastEl = $("fr-toast");
  let toastT = 0;
  function toast(t: string) { toastEl.textContent = t; toastEl.hidden = false; clearTimeout(toastT); toastT = window.setTimeout(() => (toastEl.hidden = true), 2500); }
  $("fr-shot").addEventListener("click", shot);

  let stream: MediaStream | null = null;
  async function openStream() {
    stream?.getTracks().forEach((t) => t.stop());
    stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: "environment" }, width: { ideal: 1920 }, height: { ideal: 1080 } }, audio: false });
    video.srcObject = stream;
    await video.play().catch(() => {});
  }
  const close = () => {
    stream?.getTracks().forEach((t) => t.stop()); stream = null; video.srcObject = null;
    overlay.hidden = true; document.body.style.overflow = "";
  };

  $("fr-open").addEventListener("click", async () => {
    msg.textContent = "";
    if (!navigator.mediaDevices?.getUserMedia) { msg.textContent = "這個瀏覽器不能使用相機，請改用手機的 Safari 或 Chrome。"; return; }
    if (shown.size === 0) { msg.textContent = "請至少選一個要顯示的焦段框。"; return; }
    const all = [...shown].sort((a, b) => a - b);
    active = all.reduce((best, f) => (Math.abs(f - 50) < Math.abs(best - 50) ? f : best), all[0]);
    sliderRow.hidden = !range;
    if (range) slider.value = toSlider(Math.max(range[0], Math.min(range[1], active)));
    frRatio.value = ratio.value;
    try { await openStream(); }
    catch { msg.textContent = "沒有取得相機權限。請到手機的設定允許這個網站使用相機後，再試一次。"; return; }
    overlay.hidden = false; document.body.style.overflow = "hidden";
    buildChips(); draw();
  });
  $("fr-close").addEventListener("click", close);
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !overlay.hidden) close(); });
  slider.addEventListener("input", () => { active = fromSlider(); draw(); });
  frRatio.addEventListener("change", () => { ratio.value = frRatio.value; draw(); });
  window.addEventListener("resize", draw);
  new ResizeObserver(draw).observe(canvas);
  window.addEventListener("pagehide", close);
</script>
