---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="管理頁" description="逐光管理頁（僅網站管理者可見）。">
  <p class="eyebrow">Admin</p>
  <h1>管理頁</h1>
  <div id="msg" class="cam-count">讀取中…</div>
  <div class="online" id="online" hidden>
    <span><span class="dot"></span>現在線上</span>
    <b id="onN">0</b>
    <span class="by" id="onBy"></span>
    <span class="hint">分頁開著就算一人，切到背景超過 2 分鐘不算；只記頁面名稱，不會記錄是誰。管理頁本身不算。</span>
  </div>
  <section id="stats" hidden>
    <div class="rp-head">
      <h2>使用統計</h2>
      <span class="hint" id="st-at"></span>
      <button type="button" class="btn" id="st-reload">重新整理</button>
    </div>
    <div id="st-body"><p class="cam-count">讀取中…</p></div>
  </section>

  <section id="reports" hidden>
    <div class="rp-head">
      <h2>問題回報</h2>
      <button type="button" class="btn" id="rp-reload">重新整理</button>
    </div>
    <div class="fchips" id="rp-chips" role="group" aria-label="依狀態篩選"></div>
    <div id="rp-list"><p class="cam-count">讀取中…</p></div>
  </section>
  <div class="rp-toast" id="rp-toast" hidden></div>
</BaseLayout>

<script>
  import { sb } from "../lib/auth.js";
  import { watchOnline } from "../lib/online.js";
  import { TOOLS } from "../data/site.js";
  // ---- 使用統計 ----
  const nf = (x: unknown) => Number(x || 0).toLocaleString();
  const md = (d: string) => `${+d.slice(5, 7)}/${+d.slice(8, 10)}`;
  const toolName = new Map(TOOLS.map((t) => [t.href.split("?")[0], t.name]));
  const pageName = (p: string) => (p === "/" ? "首頁" : toolName.get(p) ? `${toolName.get(p)}（${p}）` : p);
  async function loadStats() {
    const sec = document.getElementById("stats")!;
    const body = document.getElementById("st-body")!;
    sec.hidden = false;
    const btn = document.getElementById("st-reload") as HTMLButtonElement;
    btn.disabled = true;
    const { data, error } = await sb!.rpc("admin_stats");
    btn.disabled = false;
    body.innerHTML = "";
    if (error || !data) {
      const missing = !!error && (error.code === "PGRST202" || /admin_stats|could not find the function|does not exist/i.test(error.message || ""));
      body.append(el("p", "cam-count", missing
        ? "要先在 Supabase 執行 supabase/usage_stats.sql，才看得到使用統計。"
        : "統計讀取失敗，請按「重新整理」再試一次。"));
      return;
    }
    const tiles = el("div", "stiles");
    const tile = (k: string, v: unknown, sub: string) => {
      const t = el("div", "stile");
      t.append(el("div", "k", k), el("div", "v", nf(v)), el("div", "s", sub));
      tiles.append(t);
    };
    tile("註冊人數", data.users_total, `今天 +${nf(data.users_today)}・近 7 天 +${nf(data.users_7d)}`);
    tile("今天活躍人數", data.active_today, `近 7 天 ${nf(data.active_7d)} 人`);
    tile("今天頁面瀏覽", data.views_today, `近 7 天 ${nf(data.views_7d)} 次`);
    body.append(tiles);

    const days: { d: string; n: number }[] = data.daily || [];
    const max = Math.max(1, ...days.map((x) => x.n));
    const peak = days.reduce<{ d: string; n: number } | null>((a, x) => (x.n > (a?.n ?? -1) ? x : a), null);
    const bars = el("div", "sbars");
    bars.append(el("div", "k", "近 14 天每天活躍人數（當天有來過的人）"));
    const wrap = el("div", "sbarw");
    wrap.setAttribute("role", "img");
    wrap.setAttribute("aria-label", "近 14 天每天活躍人數：" + days.map((x) => `${md(x.d)} ${x.n} 人`).join("，"));
    const labels = el("div", "sbarl");
    days.forEach((x, i) => {
      const b = el("div", "sbar");
      b.title = `${md(x.d)}　${x.n} 人`;
      if (x.n && (i === days.length - 1 || x === peak)) b.append(el("span", "n", String(x.n)));
      const bar = el("i", x.n ? "" : "zero");
      bar.style.height = `${(x.n / max) * 82}%`;
      b.append(bar);
      wrap.append(b);
      labels.append(el("span", (days.length - 1 - i) % 3 ? "hm" : "", i === days.length - 1 ? "今天" : md(x.d)));
    });
    bars.append(wrap, labels);
    body.append(bars);

    const top: { page: string; views: number }[] = data.top_pages || [];
    const topBox = el("div", "stop");
    topBox.append(el("div", "k", "近 7 天最多人看的頁面"));
    if (!top.length) topBox.append(el("p", "cam-count", "還沒有資料。"));
    else {
      const ol = el("ol");
      for (const t of top) {
        const li = el("li");
        li.append(el("span", "", pageName(t.page)), el("b", "", `${nf(t.views)} 次`));
        ol.append(li);
      }
      topBox.append(ol);
    }
    body.append(topBox);
    body.append(el("p", "cam-count", "只統計人數與次數，不會顯示是誰。「活躍」是當天登入後有打開過頁面的帳號；頁面瀏覽次數與帳號分開記錄，無法得知誰看了哪一頁。日期以台灣時間計算。"));
    const t = new Date();
    document.getElementById("st-at")!.textContent = `${t.getHours()}:${String(t.getMinutes()).padStart(2, "0")} 更新`;
  }
  document.getElementById("st-reload")!.addEventListener("click", loadStats);

  const STATUSES = ["新回報", "處理中", "已修好", "不處理"];
  type Report = { id: number; created_at: string; kind: string; page: string; message: string; contact: string; device: string; status: string; admin_note: string; email: string; reply: string };
  let rows: Report[] = [];
  let filter = "未結案"; // 未結案＝新回報＋處理中
  const el = (tag: string, cls?: string, text?: string) => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  };
  const toast = (m: string) => {
    const t = document.getElementById("rp-toast")!;
    t.textContent = m; t.hidden = false;
    setTimeout(() => (t.hidden = true), 2200);
  };
  const fmtTime = (iso: string) => {
    const d = new Date(iso);
    return `${d.getMonth() + 1}/${d.getDate()} ${d.getHours()}:${String(d.getMinutes()).padStart(2, "0")}`;
  };
  const matches = (r: Report) => filter === "全部" || (filter === "未結案" ? r.status === "新回報" || r.status === "處理中" : r.status === filter);

  function drawChips() {
    const box = document.getElementById("rp-chips")!;
    box.innerHTML = "";
    const count = (f: string) => rows.filter((r) => (f === "全部" ? true : f === "未結案" ? r.status === "新回報" || r.status === "處理中" : r.status === f)).length;
    for (const f of ["未結案", ...STATUSES, "全部"]) {
      const b = el("button", f === filter ? "on" : "", f);
      b.setAttribute("type", "button");
      b.append(el("b", "", String(count(f))));
      b.addEventListener("click", () => { filter = f; draw(); });
      box.append(b);
    }
  }

  function draw() {
    drawChips();
    const box = document.getElementById("rp-list")!;
    const keep = new Map<number, string>();
    const keepReply = new Map<number, string>();
    box.querySelectorAll<HTMLElement>("[data-id]").forEach((c) => {
      const [tr, tn] = Array.from(c.querySelectorAll<HTMLTextAreaElement>("textarea"));
      const r = rows.find((x) => x.id === Number(c.dataset.id));
      if (!r) return;
      if (tn && tn.value !== r.admin_note) keep.set(r.id, tn.value); // 沒存的備註、回覆不要被清掉
      if (tr && tr.value !== r.reply) keepReply.set(r.id, tr.value);
    });
    box.innerHTML = "";
    const list = rows.filter(matches);
    if (!list.length) { box.append(el("p", "cam-count", "這個分類目前沒有回報。")); return; }
    for (const r of list) {
      const card = el("div", `rp s-${r.status}`);
      const colL = el("div", "rp-l"), colR = el("div", "rp-r");
      card.append(colL, colR);
      card.dataset.id = String(r.id);
      const top = el("div", "rp-top");
      top.append(el("span", "pill", r.kind), el("span", "rp-time", fmtTime(r.created_at)));
      if (r.page) top.append(el("span", "rp-page", r.page));
      colL.append(top, el("p", "rp-msg", r.message));
      const meta: string[] = [];
      if (r.email) meta.push(`帳號：${r.email}`);
      if (r.contact) meta.push(`聯絡：${r.contact}`);
      if (r.device) meta.push(r.device);
      if (meta.length) colL.append(el("p", "rp-meta", meta.join("　")));
      const st = el("div", "rp-st");
      for (const s of STATUSES) {
        const b = el("button", s === r.status ? "on" : "", s);
        b.setAttribute("type", "button");
        b.addEventListener("click", async () => {
          if (s === r.status) return;
          const { data, error } = await sb!.rpc("admin_update_report", { p_id: r.id, p_status: s, p_note: null });
          if (error || data !== "ok") { toast("儲存失敗，請再試一次"); return; }
          r.status = s; draw(); toast(`已改成「${s}」`);
        });
        st.append(b);
      }
      colR.append(st);
      const replyBox = el("textarea") as HTMLTextAreaElement;
      replyBox.placeholder = r.email ? "回覆（送出者會在「我的回報」看到）" : "這則是登入功能開放前的匿名回報，無法回覆";
      replyBox.maxLength = 2000;
      replyBox.disabled = !r.email;
      replyBox.value = keepReply.has(r.id) ? keepReply.get(r.id)! : r.reply;
      const saveReply = el("button", "btn", "儲存回覆");
      saveReply.setAttribute("type", "button");
      saveReply.disabled = !r.email;
      saveReply.addEventListener("click", async () => {
        const { data, error } = await sb!.rpc("admin_update_report", { p_id: r.id, p_status: null, p_note: null, p_reply: replyBox.value.trim() });
        if (error || data !== "ok") { toast("儲存失敗，請再試一次"); return; }
        r.reply = replyBox.value.trim(); draw(); toast("已儲存回覆");
      });
      colR.append(replyBox, saveReply);
      const note = el("textarea") as HTMLTextAreaElement;
      note.placeholder = "備註（只有你看得到，例如怎麼處理的）";
      note.maxLength = 2000;
      note.value = keep.has(r.id) ? keep.get(r.id)! : r.admin_note;
      const save = el("button", "btn", "儲存備註");
      save.setAttribute("type", "button");
      save.addEventListener("click", async () => {
        const { data, error } = await sb!.rpc("admin_update_report", { p_id: r.id, p_status: null, p_note: note.value.trim() });
        if (error || data !== "ok") { toast("儲存失敗，請再試一次"); return; }
        r.admin_note = note.value.trim(); draw(); toast("已儲存備註");
      });
      colR.append(note, save);
      box.append(card);
    }
  }

  async function loadReports() {
    const sec = document.getElementById("reports")!;
    const list = document.getElementById("rp-list")!;
    sec.hidden = false;
    const { data, error } = await sb!.rpc("admin_list_reports", { p_limit: 200 });
    if (error) {
      const missing = error.code === "PGRST202" || /admin_list_reports|could not find the function|does not exist/i.test(error.message || "");
      list.innerHTML = "";
      list.append(el("p", "cam-count", missing
        ? "要先在 Supabase 執行 supabase/admin_reports.sql，才看得到問題回報。"
        : "讀取失敗，請按「重新整理」再試一次。"));
      return;
    }
    rows = (data || []) as Report[];
    draw();
  }
  document.getElementById("rp-reload")!.addEventListener("click", loadReports);

  const msg = document.getElementById("msg")!;
  const box = document.getElementById("online")!;
  (async () => {
    let ok = false, missing = false;
    try {
      const { data, error } = await sb!.rpc("is_site_admin");
      ok = data === true;
      missing = !!error && /is_site_admin|could not find the function|does not exist/i.test(error.message || "");
    } catch (e) {}
    if (!ok) {
      msg.textContent = missing
        ? "這一頁需要先在 Supabase 執行 supabase/site_admins.sql，才能使用。"
        : "這一頁只有網站管理者能看。";
      return;
    }
    msg.hidden = true;
    box.hidden = false;
    loadStats();
    loadReports();
    watchOnline((st: { n: number; by: [string, number][] }) => {
      document.getElementById("onN")!.textContent = String(st.n);
      const by = document.getElementById("onBy")!;
      by.textContent = st.by.map(([p, c]) => `${p} ${c}`).join("　");
    });
  })();
</script>
