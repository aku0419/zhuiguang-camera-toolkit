---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBox from "../components/SearchBox.astro";
import { sections, TOOLS, PROBLEMS } from "../data/site.js";
import { cameras } from "../lib/cameras.js";
---
<BaseLayout description="免費的中文攝影工具與器材資料庫：快門角度、升降格、等效焦段、錄影容量計算，攝影機規格與錄影格式查詢。給影視科學生、學生劇組與獨立影像工作者。">
  <p class="eyebrow">Camera Toolkit</p>
  <h1>逐光｜攝影工具組</h1>
  <SearchBox />

  <h2>遇到什麼問題？</h2>
  <ul class="problems">
    {PROBLEMS.map((p) => <li><a href={p.href}>{p.q}</a></li>)}
  </ul>

  <p class="cam-count">看不懂名詞？<a href="/glossary/">名詞小辭典</a></p>

  <h2>全部工具</h2>
  <div class="grid">
    {TOOLS.map((t) => (
      <a class="card" href={t.href}>
        <h3>{t.name}</h3>
        <p>{t.q}</p>
      </a>
    ))}
  </div>

  <h2>資料庫</h2>
  <div class="grid">
    {sections(cameras.length > 0).filter((s) => s.id !== "tools").map((s) => (
      <a class={s.ready ? "card" : "card soon"} href={s.href}>
        <span class="k">{s.en}</span>
        <h3>{s.zh}</h3>
        <p>{s.desc}</p>
        {!s.ready && <span class="pill">即將推出</span>}
      </a>
    ))}
  </div>
</BaseLayout>
